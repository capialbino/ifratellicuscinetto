---
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../utils/paths';

interface Props {
  slug?: string;
  coverImage?: string;
  title: string;
  category: 'Meccanica' | 'AI & Software' | 'Meccatronica & Hybrid';
  variant?: 'featured' | 'card';
}

const { slug, coverImage, title, category, variant = 'card' } = Astro.props;
const cleanSlug = slug ? slug.split('/').at(-1) : '';
const uid = `${(cleanSlug || 'cover').replace(/[^a-z0-9-]/gi, '')}-${variant}`;
const autoCoverExists = cleanSlug
  ? fs.existsSync(path.resolve('public/covers', `${cleanSlug}.svg`))
  : false;

const resolvedSrc = coverImage
  ? coverImage.startsWith('http://') || coverImage.startsWith('https://')
    ? coverImage
    : withBase(coverImage)
  : autoCoverExists
    ? withBase(`/covers/${cleanSlug}.svg`)
    : null;
---

<div class:list={['article-cover', `cover-${variant}`, `cat-${category === 'Meccanica' ? 'mech' : category === 'AI & Software' ? 'ai' : 'hybrid'}`]}>
  {resolvedSrc ? (
    <img src={resolvedSrc} alt={title} loading={variant === 'featured' ? 'eager' : 'lazy'} decoding="async" />
  ) : category === 'Meccanica' ? (
    <svg viewBox="0 0 640 360" fill="none" aria-hidden="true" class="cover-svg">
      <defs>
        <radialGradient id={`mech-glow-${uid}`} cx="50%" cy="50%" r="55%">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.16" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="640" height="360" fill={`url(#mech-glow-${uid})`} />
      <line x1="80" y1="180" x2="560" y2="180" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="4 6" />
      <line x1="320" y1="30" x2="320" y2="330" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="4 6" />
      <circle cx="320" cy="180" r="118" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.5" />
      <circle cx="320" cy="180" r="96" stroke="currentColor" stroke-opacity="0.16" stroke-width="1" />
      <circle cx="320" cy="180" r="56" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.5" />
      <circle cx="320" cy="180" r="24" stroke="currentColor" stroke-opacity="0.2" stroke-width="1" />
      {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => {
        const rad = (deg * Math.PI) / 180;
        const cx = 320 + Math.cos(rad) * 76;
        const cy = 180 + Math.sin(rad) * 76;
        return <circle cx={cx} cy={cy} r="13" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" fill="currentColor" fill-opacity="0.06" />;
      })}
    </svg>
  ) : category === 'AI & Software' ? (
    <svg viewBox="0 0 640 360" fill="none" aria-hidden="true" class="cover-svg">
      <defs>
        <radialGradient id={`ai-glow-${uid}`} cx="50%" cy="50%" r="58%">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.18" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="640" height="360" fill={`url(#ai-glow-${uid})`} />
      {[120, 240, 360, 480].map((x) =>
        [95, 180, 265].map((y) => (
          <>
            {x < 480 && [95, 180, 265].map((y2) => (
              <line x1={x} y1={y} x2={x + 120} y2={y2} stroke="currentColor" stroke-opacity="0.14" stroke-width="1" />
            ))}
            <circle cx={x} cy={y} r="7" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" />
          </>
        ))
      )}
    </svg>
  ) : (
    <svg viewBox="0 0 640 360" fill="none" aria-hidden="true" class="cover-svg">
      <defs>
        <radialGradient id={`hyb-glow-${uid}`} cx="50%" cy="50%" r="55%">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.16" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="640" height="360" fill={`url(#hyb-glow-${uid})`} />
      <path d="M40 180 C120 70, 200 290, 280 180 C360 70, 440 290, 520 180 C555 130, 585 155, 600 180" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.8" />
      <path d="M40 180 C120 120, 200 240, 280 180 C360 120, 440 240, 520 180 C555 155, 585 168, 600 180" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.2" />
      <circle cx="320" cy="180" r="88" stroke="currentColor" stroke-opacity="0.22" stroke-width="1.3" stroke-dasharray="5 5" />
      <circle cx="320" cy="180" r="46" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" />
      <circle cx="280" cy="180" r="5" fill="currentColor" fill-opacity="0.65" />
      <circle cx="360" cy="180" r="5" fill="currentColor" fill-opacity="0.65" />
    </svg>
  )}
</div>

<style>
  .article-cover {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .cover-card {
    aspect-ratio: 16 / 9;
  }

  .cover-featured {
    aspect-ratio: 16 / 10;
    border-bottom: 0;
    border-radius: calc(var(--radius-card) - 6px);
    border: 1px solid var(--border);
  }

  .cat-mech {
    color: var(--accent);
  }

  .cat-ai {
    color: var(--accent-ai);
  }

  .cat-hybrid {
    color: var(--accent-hybrid);
  }

  .article-cover img,
  .cover-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-ive);
  }

  :global(.glow-card:hover) .article-cover img,
  :global(.glow-card:hover) .cover-svg {
    transform: scale(1.035);
  }
</style>
