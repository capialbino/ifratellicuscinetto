---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';
import { siteConfig } from '../utils/site-config';

interface Props {
  article: import('astro:content').CollectionEntry<'articles'>;
  locale: Locale;
  languageSwitchHref: string;
}

const { article, locale, languageSwitchHref } = Astro.props;
const { Content, headings } = await render(article);
const author = getAuthor(article.data.author, locale);
const catMeta = CATEGORY_META[article.data.category];
const readingTime = estimateReadingTime(article.body);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout
  title={`${article.data.title} — ${siteConfig.brand.name}`}
  description={article.data.description}
  activeNav="articoli"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <article class="article-page">
    <header class="article-hero engineering-grid">
      <div class="container hero-wrap">
        <a href={withBase(locale === 'it' ? '/' : '/en/')} class="back-link">
          {locale === 'it' ? '← Tutti gli articoli' : '← All articles'}
        </a>

        <div class="article-badges">
          <span class={`badge ${catMeta.badgeClass}`}>{CATEGORY_LABELS[locale][article.data.category]}</span>
          <span class="badge badge-level">{LEVEL_LABELS[locale][article.data.level]}</span>
        </div>

        <h1 class="article-title">{article.data.title}</h1>
        <p class="article-subtitle">{article.data.description}</p>

        <div class="article-meta-bar">
          <div class="author-box">
            <span class="avatar-lg" style={`background:${author.accentColor}`}>
              {author.initials}
            </span>
            <div>
              <div class="author-box-name">{author.name}</div>
              <div class="author-box-role">{author.role} · {author.discipline}</div>
            </div>
          </div>

          <div class="date-box">
            <time datetime={article.data.pubDate.toISOString()}>
              {formatDate(article.data.pubDate, locale)}
            </time>
            <span>·</span>
            <span>{readingTime} {locale === 'it' ? 'min di lettura' : 'min read'}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <div class="prose article-content">
        <Content />

        {article.data.tags.length > 0 && (
          <div class="article-tags">
            {article.data.tags.map((tag) => (
              <span class="tag-chip">#{tag}</span>
            ))}
          </div>
        )}
      </div>

      {tocHeadings.length > 0 && (
        <aside class="toc-sidebar" aria-label={locale === 'it' ? 'Indice dell’articolo' : 'Article contents'}>
          <div class="toc-box">
            <div class="toc-title">{locale === 'it' ? 'In questo articolo' : 'On this page'}</div>
            <ul class="toc-list">
              {tocHeadings.map((h) => (
                <li class:list={['toc-item', { 'toc-sub': h.depth === 3 }]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  // Lazy-loads Three.js ONLY when the article actually contains a .glb 3D model
  const frames = Array.from(document.querySelectorAll<HTMLElement>('.model-3d-frame[data-src]'));
  if (frames.length > 0) {
    (async () => {
      const [THREE, { OrbitControls }, { GLTFLoader }, { RoomEnvironment }] = await Promise.all([
        import('three'),
        import('three/examples/jsm/controls/OrbitControls.js'),
        import('three/examples/jsm/loaders/GLTFLoader.js'),
        import('three/examples/jsm/environments/RoomEnvironment.js'),
      ]);

      const isEn = document.documentElement.lang === 'en';
      const loader = new GLTFLoader();

      for (const frame of frames) {
        const src = frame.dataset.src;
        const label = frame.dataset.label || (isEn ? '3D CAD Model' : 'Modello 3D');
        if (!src) continue;

        frame.textContent = '';

        const canvas = document.createElement('canvas');
        canvas.className = 'model-3d-canvas';
        canvas.setAttribute('aria-label', label);

        const statusEl = document.createElement('div');
        statusEl.className = 'model-3d-status';
        statusEl.textContent = isEn ? 'Loading 3D model...' : 'Caricamento modello 3D...';

        const hud = document.createElement('div');
        hud.className = 'model-3d-hud';

        const labelSpan = document.createElement('span');
        labelSpan.textContent = label;

        const hintSpan = document.createElement('span');
        hintSpan.textContent = isEn ? 'Drag to rotate' : 'Trascina per ruotare';

        hud.append(labelSpan, hintSpan);
        frame.append(canvas, statusEl, hud);

        let renderer: InstanceType<typeof THREE.WebGLRenderer>;
        try {
          renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        } catch {
          statusEl.textContent = isEn
            ? 'WebGL is not available on this device.'
            : 'WebGL non disponibile su questo dispositivo.';
          canvas.remove();
          hud.remove();
          continue;
        }
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.1;

        const scene = new THREE.Scene();
        const pmrem = new THREE.PMREMGenerator(renderer);
        const roomEnv = new RoomEnvironment();
        scene.environment = pmrem.fromScene(roomEnv, 0.04).texture;
        pmrem.dispose();
        roomEnv.dispose();

        const camera = new THREE.PerspectiveCamera(36, 16 / 10, 0.05, 200);
        camera.position.set(2.4, 1.7, 3.2);

        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.enableZoom = false;

        const light = new THREE.DirectionalLight(0xffffff, 2.0);
        light.position.set(4, 6, 5);
        scene.add(light);

        const resize = () => {
          const w = frame.clientWidth || 640;
          const h = frame.clientHeight || 400;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h, false);
        };
        new ResizeObserver(resize).observe(frame);
        resize();

        loader.load(
          src,
          (gltf) => {
            const root = gltf.scene;
            const box = new THREE.Box3().setFromObject(root);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());
            const maxDim = Math.max(size.x, size.y, size.z) || 1;
            const scale = 2.4 / maxDim;
            root.scale.setScalar(scale);
            root.position.sub(center.multiplyScalar(scale));
            scene.add(root);
            statusEl.remove();
          },
          undefined,
          () => {
            statusEl.textContent = isEn ? 'Unable to load 3D model.' : 'Impossibile caricare il modello 3D.';
          }
        );

        let rafId: number | null = null;
        const animate = () => {
          rafId = requestAnimationFrame(animate);
          controls.update();
          renderer.render(scene, camera);
        };
        const startLoop = () => {
          if (rafId === null) rafId = requestAnimationFrame(animate);
        };
        const stopLoop = () => {
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        };

        new IntersectionObserver((entries) => {
          if (entries[0]?.isIntersecting) startLoop();
          else stopLoop();
        }).observe(frame);
      }
    })();
  }
</script>

<script is:inline>
  (() => {
    const blocks = document.querySelectorAll('.prose pre');
    for (const pre of blocks) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      const copyLabel = document.documentElement.lang === 'en' ? 'Copy' : 'Copia';
      const copiedLabel = document.documentElement.lang === 'en' ? 'Copied' : 'Copiato';
      btn.textContent = copyLabel;
      btn.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = copiedLabel;
          setTimeout(() => (btn.textContent = copyLabel), 1600);
        } catch {
          // Clipboard API unavailable
        }
      });
      pre.appendChild(btn);
    }
  })();
</script>

<style>
  .article-hero {
    border-bottom: 1px solid var(--border);
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(2.25rem, 5vw, 3.5rem);
  }

  .hero-wrap {
    max-width: 820px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .article-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
  }

  .article-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.038em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .article-subtitle {
    margin: 0 0 2rem;
    font-size: clamp(1.06rem, 1.8vw, 1.24rem);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--border);
  }

  .author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar-lg {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .author-box-name {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .author-box-role {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .date-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 3.5rem;
    padding-top: 3rem;
    align-items: start;
  }

  .article-content {
    min-width: 0;
  }

  .article-tags {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-chip {
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.24rem 0.7rem;
    border-radius: 980px;
  }

  .toc-sidebar {
    position: sticky;
    top: 84px;
  }

  .toc-box {
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  .toc-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.83rem;
  }

  .toc-item a {
    color: var(--text-muted);
    line-height: 1.4;
    display: block;
    transition: color 0.2s var(--ease-ive);
  }

  .toc-item a:hover {
    color: var(--text);
  }

  .toc-sub {
    padding-left: 0.75rem;
    font-size: 0.79rem;
  }

  :global(.copy-code-btn) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    padding: 0.24rem 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 980px;
    cursor: pointer;
    transition: color 0.2s var(--ease-ive), border-color 0.2s var(--ease-ive);
  }

  :global(.copy-code-btn:hover) {
    color: var(--text);
    border-color: var(--border-strong);
  }

  :global(.model-3d-frame) {
    position: relative;
    width: 100%;
    height: 420px;
    margin: 2rem 0;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--accent) 8%, var(--bg-elevated)),
      var(--bg-elevated) 72%
    );
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  :global(.model-3d-canvas) {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  :global(.model-3d-canvas:active) {
    cursor: grabbing;
  }

  :global(.model-3d-status) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  :global(.model-3d-hud) {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.85rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  :global(.model-3d-hud span) {
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    padding: 0.24rem 0.65rem;
    border-radius: 980px;
    border: 1px solid var(--border);
  }

  @media (max-width: 960px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .toc-sidebar {
      display: none;
    }
  }
</style>
