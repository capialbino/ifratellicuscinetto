---
import type { CollectionEntry } from 'astro:content';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';
import ArticleCover from './ArticleCover.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  locale?: Locale;
}

const { article, locale = 'it' } = Astro.props;
const { data, id, body } = article;
const author = getAuthor(data.author, locale);
const catMeta = CATEGORY_META[data.category];
const readingTime = estimateReadingTime(body);
---

<article
  class="article-card glow-card"
  data-category={catMeta.slug}
  data-author={data.author}
  data-search={`${data.title} ${data.description} ${data.tags.join(' ')} ${author.name}`.toLowerCase()}
>
  <a href={withBase(locale === 'it' ? `/articoli/${id}` : `/en/articles/${id.split('/').at(-1)}`)} class="card-link">
    <ArticleCover
      slug={id}
      coverImage={data.coverImage}
      title={data.title}
      category={data.category}
      variant="card"
    />

    <div class="card-body">
      <div class="card-top">
        <span class={`cat-eyebrow ${catMeta.badgeClass}`}>
          <span class="cat-dot"></span>
          {CATEGORY_LABELS[locale][data.category]}
        </span>
        <span class="level-label">{LEVEL_LABELS[locale][data.level]}</span>
      </div>

      <h2 class="card-title">{data.title}</h2>
      <p class="card-desc">{data.description}</p>

      <div class="card-footer">
        <div class="author-mini">
          <span class="avatar-dot" style={`background:${author.accentColor}`}>
            {author.initials}
          </span>
          <div>
            <div class="author-name">{author.name}</div>
            <div class="card-meta">
              <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime} min</span>
            </div>
          </div>
        </div>

        <span class="card-arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card {
    position: relative;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
    transition:
      transform 0.5s var(--ease-ive),
      box-shadow 0.35s var(--ease-ive),
      border-color 0.35s var(--ease-ive);
  }

  .article-card.is-tilting {
    transition:
      transform 0.12s ease-out,
      box-shadow 0.35s var(--ease-ive),
      border-color 0.35s var(--ease-ive);
  }

  .article-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(
        340px circle at var(--mx, 50%) var(--my, 50%),
        rgba(255, 255, 255, 0.24),
        transparent 52%
      ),
      radial-gradient(
        420px circle at var(--mx, 50%) var(--my, 50%),
        color-mix(in srgb, var(--accent) 16%, transparent),
        transparent 68%
      );
    transition: opacity 0.35s var(--ease-ive);
    z-index: 2;
  }

  .article-card:hover {
    transform: perspective(1050px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(-5px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border-strong));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent),
      0 14px 36px color-mix(in srgb, var(--accent) 16%, transparent),
      var(--shadow-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card:hover {
      transform: translateY(-2px);
    }
  }

  .article-card:hover::before {
    opacity: 1;
  }

  .card-link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.45rem 1.6rem 1.55rem;
    gap: 0.8rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cat-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: transparent !important;
    padding: 0;
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .level-label {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
    transition: color 0.25s var(--ease-ive);
  }

  .article-card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.58;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: 0.5rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .author-mini {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .avatar-dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.25;
    color: var(--text);
  }

  .card-meta {
    font-size: 0.74rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-arrow {
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: transform 0.25s var(--ease-ive), color 0.25s var(--ease-ive);
  }

  .article-card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
