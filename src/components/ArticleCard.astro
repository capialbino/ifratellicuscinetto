---
import type { CollectionEntry } from 'astro:content';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';

interface Props {
  article: CollectionEntry<'articles'>;
  locale?: Locale;
}

const { article, locale = 'it' } = Astro.props;
const { data, id, body } = article;
const author = getAuthor(data.author, locale);
const catMeta = CATEGORY_META[data.category];
const readingTime = estimateReadingTime(body);
---

<article
  class="article-card"
  data-category={catMeta.slug}
  data-author={data.author}
  data-search={`${data.title} ${data.description} ${data.tags.join(' ')} ${author.name}`.toLowerCase()}
>
  <a href={withBase(locale === 'it' ? `/articoli/${id}` : `/en/articles/${id.split('/').at(-1)}`)} class="card-link">
    <div class="card-top">
      <span class={`cat-eyebrow ${catMeta.badgeClass}`}>
        <span class="cat-dot"></span>
        {CATEGORY_LABELS[locale][data.category]}
      </span>
      <span class="level-label">{LEVEL_LABELS[locale][data.level]}</span>
    </div>

    <h2 class="card-title">{data.title}</h2>
    <p class="card-desc">{data.description}</p>

    <div class="card-footer">
      <div class="author-mini">
        <span class="avatar-dot" style={`background:${author.accentColor}`}>
          {author.initials}
        </span>
        <div>
          <div class="author-name">{author.name}</div>
          <div class="card-meta">
            <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min</span>
          </div>
        </div>
      </div>

      <span class="card-arrow" aria-hidden="true">→</span>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease-ive), box-shadow 0.35s var(--ease-ive), border-color 0.35s var(--ease-ive);
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    gap: 0.9rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cat-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: transparent !important;
    padding: 0;
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .level-label {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
    transition: color 0.25s var(--ease-ive);
  }

  .article-card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text-muted);
    line-height: 1.58;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: 0.6rem;
    padding-top: 1.05rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .author-mini {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .avatar-dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.25;
    color: var(--text);
  }

  .card-meta {
    font-size: 0.74rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-arrow {
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: transform 0.25s var(--ease-ive), color 0.25s var(--ease-ive);
  }

  .article-card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
