---
import type { CollectionEntry } from 'astro:content';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';

interface Props {
  article: CollectionEntry<'articles'>;
  locale?: Locale;
}

const { article, locale = 'it' } = Astro.props;
const { data, id, body } = article;
const author = getAuthor(data.author, locale);
const catMeta = CATEGORY_META[data.category];
const readingTime = estimateReadingTime(body);
---

<article
  class="article-card"
  data-category={catMeta.slug}
  data-author={data.author}
  data-search={`${data.title} ${data.description} ${data.tags.join(' ')} ${author.name}`.toLowerCase()}
>
  <a href={withBase(locale === 'it' ? `/articoli/${id}` : `/en/articles/${id.split('/').at(-1)}`)} class="card-link">
    <div class="card-top">
      <span class={`badge ${catMeta.badgeClass}`}>{CATEGORY_LABELS[locale][data.category]}</span>
      <span class="badge badge-level">{LEVEL_LABELS[locale][data.level]}</span>
    </div>

    <h2 class="card-title">{data.title}</h2>
    <p class="card-desc">{data.description}</p>

    {data.tags.length > 0 && (
      <div class="card-tags">
        {data.tags.slice(0, 4).map((tag) => (
          <span class="tag-pill">#{tag}</span>
        ))}
      </div>
    )}

    <div class="card-footer">
      <div class="author-mini">
        <span class="avatar-dot" style={`background:${author.accentColor}`}>
          {author.initials}
        </span>
        <div>
          <div class="author-name">{author.name}</div>
          <div class="author-role">{author.role}</div>
        </div>
      </div>

      <div class="card-meta">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min</span>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    box-shadow: var(--shadow-sm);
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem;
    gap: 0.85rem;
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .card-title {
    margin: 0;
    font-size: 1.24rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .article-card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
  }

  .card-footer {
    margin-top: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .card-footer {
      flex-wrap: wrap;
    }

    .card-meta {
      margin-left: auto;
    }
  }

  .author-mini {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .avatar-dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .author-role {
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.2;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }
</style>
