---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bearing3D from './Bearing3D.astro';
import { AUTHORS, getAuthor } from '../data/authors';
import type { Locale } from '../utils/articles';
import { siteConfig } from '../utils/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const languageSwitchHref = locale === 'it' ? '/en/about' : '/chi-siamo';
const members = (Object.keys(AUTHORS) as Array<keyof typeof AUTHORS>).map((id) =>
  getAuthor(id, locale)
);
---

<BaseLayout
  title={locale === 'it' ? `Chi siamo — ${siteConfig.brand.name}` : `About — ${siteConfig.brand.name}`}
  description={locale === 'it'
    ? 'Tre ingegneri che scrivono di meccanica, software e intelligenza artificiale.'
    : 'Three engineers writing about mechanical engineering, software, and artificial intelligence.'}
  activeNav="chi-siamo"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <section class="about-hero">
    <div class="container about-hero-grid">
      <div class="about-hero-inner">
        <h1 class="about-title">
          {locale === 'it' ? 'Chi siamo' : 'About'}
        </h1>
        <p class="about-lead">
          {locale === 'it'
            ? 'Due ingegneri meccanici e un ingegnere informatico. Scriviamo articoli tecnici su quello che studiamo e su cui lavoriamo: meccanica, sistemi, software e AI.'
            : 'Two mechanical engineers and a computer engineer. We write technical articles on what we study and work on: mechanical engineering, systems, software, and AI.'}
        </p>
      </div>

      <Bearing3D locale={locale} />
    </div>
  </section>

  <section class="container team-section">
    <div class="team-grid">
      {members.map((member) => (
        <div class="member-card">
          <div class="member-head">
            <span class="member-avatar" style={`background:${member.accentColor}`}>
              {member.initials}
            </span>
            <div>
              <h2 class="member-name">{member.name}</h2>
              <div class="member-role">{member.role}</div>
              <div class="member-disc">{member.discipline}</div>
            </div>
          </div>
          <p class="member-bio">{member.bio}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: clamp(2.5rem, 6vw, 4.25rem) 0 clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .about-hero-inner {
    max-width: 560px;
  }

  @media (max-width: 860px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .about-lead {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .team-section {
    padding-top: var(--section-gap);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .member-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .member-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .member-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .member-name {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .member-role {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--accent);
  }

  .member-disc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .member-bio {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
