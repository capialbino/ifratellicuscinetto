---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAuthor } from '../data/authors';
import type { Locale } from '../utils/articles';
import { siteConfig } from '../utils/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const articles = allArticles.filter((article) => article.data.language === locale);
const languageSwitchHref = locale === 'it' ? '/en/' : '/';
const isCentered = siteConfig.theme.heroAlign === 'center';
---

<BaseLayout
  title={locale === 'it'
    ? `${siteConfig.brand.name} — Ingegneria Meccanica, AI e Divulgazione Tecnica`
    : `${siteConfig.brand.name} — Mechanical Engineering, AI and Technical Writing`}
  description={locale === 'it' ? siteConfig.hero.leadIt : siteConfig.hero.leadEn}
  activeNav="articoli"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <section class:list={['hero engineering-grid', { 'hero-centered': isCentered }]}>
    <div class="container hero-inner">
      <p class="hero-kicker">
        {locale === 'it' ? siteConfig.hero.kickerIt : siteConfig.hero.kickerEn}
      </p>
      <h1 class="hero-title">
        {locale === 'it' ? siteConfig.hero.titleIt : siteConfig.hero.titleEn}
      </h1>
      <p class="hero-lead">
        {locale === 'it' ? siteConfig.hero.leadIt : siteConfig.hero.leadEn}
      </p>

      {siteConfig.hero.showPillars && siteConfig.hero.pillars.length > 0 && (
        <div class="hero-pillars">
          {siteConfig.hero.pillars.map((pillar) => (
            <div class="pillar">
              <span class="pillar-code">{locale === 'it' ? pillar.codeIt : pillar.codeEn}</span>
              <span class="pillar-text">{locale === 'it' ? pillar.textIt : pillar.textEn}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="container catalog-section" aria-label={locale === 'it' ? 'Archivio articoli' : 'Article archive'}>
    <div class="filter-bar">
      <div class="category-pills" role="tablist" aria-label={locale === 'it' ? 'Filtra per area' : 'Filter by topic'}>
        <button type="button" class="pill active" data-cat="all">{locale === 'it' ? 'Tutti' : 'All'} ({articles.length})</button>
        <button type="button" class="pill" data-cat="meccatronica-hybrid">{locale === 'it' ? 'Meccanica × AI' : 'Mechanical × AI'}</button>
        <button type="button" class="pill" data-cat="meccanica">{locale === 'it' ? 'Meccanica' : 'Mechanical Engineering'}</button>
        <button type="button" class="pill" data-cat="ai-software">AI &amp; Software</button>
      </div>

      <div class="filter-controls">
        <select id="author-filter" aria-label={locale === 'it' ? 'Filtra per autore' : 'Filter by author'} class="control-select">
          <option value="all">{locale === 'it' ? 'Tutti gli autori' : 'All authors'}</option>
          {(['federico-pappafava', 'alessandro-rossi', 'alessandro-capialbi'] as const).map((id) => {
            const a = getAuthor(id, locale);
            return (
              <option value={a.id}>{a.name}</option>
            );
          })}
        </select>

        <input
          id="search-input"
          type="search"
          placeholder={locale === 'it' ? 'Cerca...' : 'Search...'}
          aria-label={locale === 'it' ? 'Cerca articoli' : 'Search articles'}
          class="control-search"
        />
      </div>
    </div>

    <div id="articles-grid" class="articles-grid">
      {articles.map((article) => (
        <ArticleCard article={article} locale={locale} />
      ))}
    </div>

    <div id="empty-state" class="empty-state" hidden>
      {locale === 'it'
        ? 'Nessun articolo corrisponde ai filtri selezionati.'
        : 'No articles match your filters.'}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.getElementById('articles-grid');
    const empty = document.getElementById('empty-state');
    const searchInput = document.getElementById('search-input');
    const authorSelect = document.getElementById('author-filter');
    const pills = Array.from(document.querySelectorAll('.pill[data-cat]'));
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.article-card'));
    let activeCat = 'all';

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const author = authorSelect?.value || 'all';
      let visible = 0;

      for (const card of cards) {
        const catMatch = activeCat === 'all' || card.dataset.category === activeCat;
        const authorMatch = author === 'all' || card.dataset.author === author;
        const searchMatch = !q || (card.dataset.search || '').includes(q);
        const show = catMatch && authorMatch && searchMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      if (empty) empty.hidden = visible > 0;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        activeCat = pill.dataset.cat || 'all';
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    authorSelect?.addEventListener('change', applyFilters);
  })();
</script>

<style>
  .hero {
    padding: var(--hero-pad-y) 0 calc(var(--hero-pad-y) * 0.72);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .hero-centered .hero-inner {
    align-items: center;
    text-align: center;
  }

  .hero-kicker {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.005em;
  }

  .hero-title {
    margin: 0;
    max-width: 17ch;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5.6vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: -0.042em;
    font-weight: 600;
    text-wrap: balance;
    background: linear-gradient(180deg, var(--text) 45%, color-mix(in srgb, var(--text) 62%, var(--text-muted)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    margin: 0;
    max-width: 56ch;
    font-size: clamp(1.04rem, 1.8vw, 1.24rem);
    line-height: 1.55;
    color: var(--text-muted);
    font-weight: 400;
    text-wrap: pretty;
  }

  .hero-pillars {
    margin-top: 2.25rem;
    padding-top: 2rem;
    width: 100%;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    text-align: left;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pillar-code {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .pillar-text {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .catalog-section {
    padding-top: var(--section-gap);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .category-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.28rem;
    border-radius: 980px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .pill {
    padding: 0.4rem 0.9rem;
    border-radius: 980px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease-ive);
  }

  .pill:hover {
    color: var(--text);
  }

  .pill.active {
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .control-select,
  .control-search {
    height: 36px;
    padding: 0 0.9rem;
    border-radius: 980px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    transition: border-color 0.2s var(--ease-ive);
  }

  .control-select:focus,
  .control-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .control-search {
    min-width: 190px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    margin-top: 2.5rem;
    padding: 3rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .hero-pillars {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }

    .category-pills {
      border-radius: var(--radius-control);
    }

    .filter-controls {
      width: 100%;
    }

    .control-select,
    .control-search {
      width: 100%;
      min-width: 0;
    }
  }
</style>
