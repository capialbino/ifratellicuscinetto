---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAuthor } from '../data/authors';
import type { Locale } from '../utils/articles';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const articles = allArticles.filter((article) => article.data.language === locale);
const languageSwitchHref = locale === 'it' ? '/en/' : '/';
---

<BaseLayout
  title={locale === 'it'
    ? 'I Fratelli Cuscinetto — Ingegneria Meccanica, AI e Divulgazione Tecnica'
    : 'I Fratelli Cuscinetto — Mechanical Engineering, AI and Technical Insights'}
  description={locale === 'it'
    ? 'Divulgazione tecnica su ingegneria meccanica, intelligenza artificiale e dove i due mondi si incontrano.'
    : 'Technical insights on mechanical engineering, artificial intelligence, and where the two fields meet.'}
  activeNav="articoli"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <section class="hero engineering-grid">
    <div class="container hero-inner">
      <div class="hero-kicker">
        <span class="kicker-dot"></span>
        <span>{locale === 'it' ? '2 Ingegneri Meccanici + 1 Ingegnere Informatico' : '2 Mechanical Engineers + 1 Computer Engineer'}</span>
      </div>
      <h1 class="hero-title">
        {locale === 'it'
          ? <>Dove gli <span class="accent-mech">ingranaggi</span> incontrano le <span class="accent-ai">reti neurali</span>.</>
          : <>Where <span class="accent-mech">gears</span> meet <span class="accent-ai">neural networks</span>.</>}
      </h1>
      <p class="hero-lead">
        {locale === 'it'
          ? "Divulgazione scientifica senza paura delle equazioni: scriviamo di tribologia, termofluidodinamica, modelli fisici, intelligenza artificiale applicata all'industria e architetture software."
          : 'Engineering insights without shying away from equations: we write about tribology, thermofluid dynamics, physical models, industrial AI, and software architecture.'}
      </p>

      <div class="hero-pillars">
        <div class="pillar">
          <span class="pillar-code">{locale === 'it' ? '01 / MECCANICA' : '01 / MECHANICS'}</span>
          <span>{locale === 'it' ? 'Organi di macchine, FEM, fluidodinamica e dinamica reale.' : 'Machine elements, FEA, fluid dynamics, and real-world dynamics.'}</span>
        </div>
        <div class="pillar">
          <span class="pillar-code">02 / {locale === 'it' ? 'AI & CODICE' : 'AI & CODE'}</span>
          <span>{locale === 'it' ? 'Deep learning, controllo, ottimizzazione e sistemi ad alte prestazioni.' : 'Deep learning, control, optimization, and high-performance systems.'}</span>
        </div>
        <div class="pillar">
          <span class="pillar-code">03 / {locale === 'it' ? 'IBRIDO' : 'HYBRID'}</span>
          <span>{locale === 'it' ? 'PINN, manutenzione predittiva, digital twin e sensoristica.' : 'PINNs, predictive maintenance, digital twins, and sensing.'}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container catalog-section" aria-label={locale === 'it' ? 'Archivio articoli' : 'Article archive'}>
    <div class="filter-bar">
      <div class="category-pills" role="tablist" aria-label={locale === 'it' ? 'Filtra per area' : 'Filter by topic'}>
        <button type="button" class="pill active" data-cat="all">{locale === 'it' ? 'Tutti' : 'All'} ({articles.length})</button>
        <button type="button" class="pill" data-cat="meccatronica-hybrid">{locale === 'it' ? 'Meccanica × AI' : 'Mechanical × AI'}</button>
        <button type="button" class="pill" data-cat="meccanica">{locale === 'it' ? 'Meccanica' : 'Mechanical Engineering'}</button>
        <button type="button" class="pill" data-cat="ai-software">AI &amp; Software</button>
      </div>

      <div class="filter-controls">
        <select id="author-filter" aria-label={locale === 'it' ? 'Filtra per autore' : 'Filter by author'} class="control-select">
          <option value="all">{locale === 'it' ? 'Tutti gli autori' : 'All authors'}</option>
          {(['marco', 'luca', 'alessandro'] as const).map((id) => {
            const a = getAuthor(id, locale);
            return (
            <option value={a.id}>{a.name} ({a.role})</option>
            );
          })}
        </select>

        <input
          id="search-input"
          type="search"
          placeholder={locale === 'it' ? 'Cerca titolo, tag, formula...' : 'Search titles, tags, formulas...'}
          aria-label={locale === 'it' ? 'Cerca articoli' : 'Search articles'}
          class="control-search"
        />
      </div>
    </div>

    <div id="articles-grid" class="articles-grid">
      {articles.map((article) => (
        <ArticleCard article={article} locale={locale} />
      ))}
    </div>

    <div id="empty-state" class="empty-state" hidden>
      {locale === 'it'
        ? 'Nessun articolo corrisponde ai filtri selezionati. Prova a cambiare categoria o parola chiave.'
        : 'No articles match your filters. Try another category or search term.'}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.getElementById('articles-grid');
    const empty = document.getElementById('empty-state');
    const searchInput = document.getElementById('search-input');
    const authorSelect = document.getElementById('author-filter');
    const pills = Array.from(document.querySelectorAll('.pill[data-cat]'));
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.article-card'));
    let activeCat = 'all';

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const author = authorSelect?.value || 'all';
      let visible = 0;

      for (const card of cards) {
        const catMatch = activeCat === 'all' || card.dataset.category === activeCat;
        const authorMatch = author === 'all' || card.dataset.author === author;
        const searchMatch = !q || (card.dataset.search || '').includes(q);
        const show = catMatch && authorMatch && searchMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      if (empty) empty.hidden = visible > 0;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        activeCat = pill.dataset.cat || 'all';
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    authorSelect?.addEventListener('change', applyFilters);
  })();
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    padding: 4rem 0 3.25rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.75rem 0 2.25rem;
    }

    .catalog-section {
      padding-top: 1.75rem;
    }

    .filter-controls {
      width: 100%;
    }

    .control-select,
    .control-search {
      width: 100%;
      min-width: 0;
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .accent-mech {
    color: var(--accent);
  }

  .accent-ai {
    color: var(--accent-ai);
  }

  .hero-lead {
    margin: 0;
    max-width: 62ch;
    font-size: 1.12rem;
    color: var(--text-muted);
  }

  .hero-pillars {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .pillar-code {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    font-weight: 600;
    color: var(--text);
  }

  .catalog-section {
    padding-top: 2.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pill:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .pill.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .control-select,
  .control-search {
    height: 38px;
    padding: 0 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.88rem;
  }

  .control-search {
    min-width: 220px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
    gap: 1.25rem;
  }

  .empty-state {
    margin-top: 2rem;
    padding: 2.5rem;
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: 14px;
    color: var(--text-muted);
  }
</style>
