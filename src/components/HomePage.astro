---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleCover from '../components/ArticleCover.astro';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';
import { siteConfig } from '../utils/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const articles = allArticles.filter((article) => article.data.language === locale);
const [featuredArticle] = articles;
const featuredAuthor = featuredArticle ? getAuthor(featuredArticle.data.author, locale) : null;
const featuredCat = featuredArticle ? CATEGORY_META[featuredArticle.data.category] : null;
const featuredReadTime = featuredArticle ? estimateReadingTime(featuredArticle.body) : 1;

const languageSwitchHref = locale === 'it' ? '/en/' : '/';
---

<BaseLayout
  title={locale === 'it'
    ? `${siteConfig.brand.name} — ${siteConfig.brand.subtitleIt}`
    : `${siteConfig.brand.name} — ${siteConfig.brand.subtitleEn}`}
  description={locale === 'it' ? siteConfig.hero.leadIt : siteConfig.hero.leadEn}
  activeNav="articoli"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <!-- Subito in alto: Latest article -->
  {featuredArticle && featuredAuthor && featuredCat && (
    <section id="featured-section" class="container featured-section" aria-label={locale === 'it' ? 'Ultimo articolo' : 'Latest article'}>
      <a
        href={withBase(locale === 'it' ? `/articoli/${featuredArticle.id}` : `/en/articles/${featuredArticle.id.split('/').at(-1)}`)}
        class="featured-card glow-card"
      >
        <div class="featured-body">
          <div class="featured-top">
            <span class="featured-label">{locale === 'it' ? 'Ultimo articolo' : 'Latest article'}</span>
            <span class="meta-sep">·</span>
            <span class={`cat-eyebrow ${featuredCat.badgeClass}`}>
              <span class="cat-dot"></span>
              {CATEGORY_LABELS[locale][featuredArticle.data.category]}
            </span>
            <span class="meta-sep">·</span>
            <span class="featured-level">{LEVEL_LABELS[locale][featuredArticle.data.level]}</span>
          </div>

          <h1 class="featured-title">{featuredArticle.data.title}</h1>
          <p class="featured-desc">{featuredArticle.data.description}</p>

          <div class="featured-footer">
            <div class="author-mini">
              <span class="avatar-dot" style={`background:${featuredAuthor.accentColor}`}>
                {featuredAuthor.initials}
              </span>
              <div>
                <div class="author-name">{featuredAuthor.name}</div>
                <div class="featured-meta">
                  <time datetime={featuredArticle.data.pubDate.toISOString()}>
                    {formatDate(featuredArticle.data.pubDate, locale)}
                  </time>
                  <span>·</span>
                  <span>{featuredReadTime} {locale === 'it' ? 'min di lettura' : 'min read'}</span>
                </div>
              </div>
            </div>

            <span class="read-cta">
              {locale === 'it' ? 'Leggi →' : 'Read →'}
            </span>
          </div>
        </div>

        <div class="featured-media">
          <ArticleCover
            slug={featuredArticle.id}
            coverImage={featuredArticle.data.coverImage}
            title={featuredArticle.data.title}
            category={featuredArticle.data.category}
            variant="featured"
          />
        </div>
      </a>
    </section>
  )}

  <!-- Archivio e filtri -->
  <section class="container catalog-section" aria-label={locale === 'it' ? 'Archivio articoli' : 'Article archive'}>
    <div class="filter-bar">
      <div class="category-pills" role="tablist" aria-label={locale === 'it' ? 'Filtra per area' : 'Filter by topic'}>
        <button type="button" role="tab" aria-selected="true" class="pill active" data-cat="all">{locale === 'it' ? 'Tutti' : 'All'} ({articles.length})</button>
        <button type="button" role="tab" aria-selected="false" class="pill" data-cat="meccatronica-hybrid">{locale === 'it' ? 'Meccanica × AI' : 'Mechanical × AI'}</button>
        <button type="button" role="tab" aria-selected="false" class="pill" data-cat="meccanica">{locale === 'it' ? 'Meccanica' : 'Mechanical Engineering'}</button>
        <button type="button" role="tab" aria-selected="false" class="pill" data-cat="ai-software">AI &amp; Software</button>
      </div>

      <div class="filter-controls">
        <select id="author-filter" aria-label={locale === 'it' ? 'Filtra per autore' : 'Filter by author'} class="control-select">
          <option value="all">{locale === 'it' ? 'Tutti gli autori' : 'All authors'}</option>
          {(['federico-pappafava', 'alessandro-rossi', 'alessandro-capialbi'] as const).map((id) => {
            const a = getAuthor(id, locale);
            return <option value={a.id}>{a.name}</option>;
          })}
        </select>

        <input
          id="search-input"
          type="search"
          placeholder={locale === 'it' ? 'Cerca...' : 'Search...'}
          aria-label={locale === 'it' ? 'Cerca articoli' : 'Search articles'}
          class="control-search"
        />
      </div>
    </div>

    <div id="articles-grid" class="articles-grid">
      {articles.map((article, idx) => (
        <div class:list={['grid-slot', { 'is-featured-dup': idx === 0 }]}>
          <ArticleCard article={article} locale={locale} />
        </div>
      ))}
    </div>

    <div id="empty-state" class="empty-state" hidden>
      {locale === 'it'
        ? 'Nessun articolo corrisponde ai filtri selezionati.'
        : 'No articles match your filters.'}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.getElementById('articles-grid');
    const featuredSection = document.getElementById('featured-section');
    const empty = document.getElementById('empty-state');
    const searchInput = document.getElementById('search-input');
    const authorSelect = document.getElementById('author-filter');
    const pills = Array.from(document.querySelectorAll('.pill[data-cat]'));

    // Illuminazione dinamica che segue il cursore sulle card
    document.querySelectorAll('.glow-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      });
    });

    // Copertine video 3D (.mp4/.webm): riproduzione solo quando visibili in viewport
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coverVideos = Array.from(document.querySelectorAll('video[data-autoplay-cover]'));
    if (coverVideos.length > 0) {
      if (reduceMotion) {
        coverVideos.forEach((v) => {
          v.controls = true;
        });
      } else if ('IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const vid = entry.target;
              if (entry.isIntersecting) {
                vid.play().catch(() => {});
              } else {
                vid.pause();
              }
            }
          },
          { threshold: 0.2 }
        );
        coverVideos.forEach((v) => videoObserver.observe(v));
      }
    }

    if (!grid) return;

    const slots = Array.from(grid.querySelectorAll('.grid-slot'));
    let activeCat = 'all';

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const author = authorSelect?.value || 'all';
      const isFiltering = activeCat !== 'all' || author !== 'all' || Boolean(q);
      let visible = 0;

      grid.classList.toggle('is-filtering', isFiltering);

      if (featuredSection) {
        featuredSection.hidden = isFiltering;
      }

      for (const slot of slots) {
        const card = slot.querySelector('.article-card');
        if (!card) continue;
        const isDup = slot.classList.contains('is-featured-dup');
        if (!isFiltering && isDup) {
          slot.style.display = 'none';
          visible++;
          continue;
        }
        const catMatch = activeCat === 'all' || card.dataset.category === activeCat;
        const authorMatch = author === 'all' || card.dataset.author === author;
        const searchMatch = !q || (card.dataset.search || '').includes(q);
        const show = catMatch && authorMatch && searchMatch;
        slot.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      if (empty) empty.hidden = visible > 0;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');
        activeCat = pill.dataset.cat || 'all';
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    authorSelect?.addEventListener('change', applyFilters);
    applyFilters();
  })();
</script>

<style>
  .featured-section {
    padding-top: clamp(2rem, 4.5vw, 3.25rem);
    padding-bottom: 2.25rem;
  }

  .featured-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.9fr);
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    padding: clamp(1.75rem, 3.8vw, 2.5rem);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition:
      transform 0.35s var(--ease-ive),
      box-shadow 0.35s var(--ease-ive),
      border-color 0.35s var(--ease-ive),
      background-color 0.35s var(--ease-ive);
  }

  .featured-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      560px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 65%
    );
    transition: opacity 0.35s var(--ease-ive);
    z-index: 2;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border-strong));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent),
      0 14px 38px color-mix(in srgb, var(--accent) 16%, transparent),
      var(--shadow-md);
  }

  .featured-card:hover::before {
    opacity: 1;
  }

  .featured-body,
  .featured-media {
    position: relative;
    z-index: 1;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .featured-label {
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }

  .meta-sep {
    color: var(--text-muted);
  }

  .cat-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-weight: 600;
    background: transparent !important;
    padding: 0;
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .featured-level {
    color: var(--text-muted);
  }

  .featured-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.2vw, 2.35rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.034em;
    color: var(--text);
    text-wrap: balance;
    transition: color 0.25s var(--ease-ive);
  }

  .featured-card:hover .featured-title {
    color: var(--accent);
  }

  .featured-desc {
    margin: 0;
    max-width: 60ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .featured-footer {
    margin-top: 0.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .author-mini {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .avatar-dot {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.74rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .read-cta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    transition: transform 0.25s var(--ease-ive);
  }

  .featured-card:hover .read-cta {
    transform: translateX(4px);
  }

  /* Catalog */
  .catalog-section {
    padding-top: 0.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .category-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.28rem;
    border-radius: 980px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .pill {
    padding: 0.4rem 0.9rem;
    border-radius: 980px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease-ive);
  }

  .pill:hover {
    color: var(--text);
  }

  .pill.active {
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .control-select,
  .control-search {
    height: 36px;
    padding: 0 0.9rem;
    border-radius: 980px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    transition: border-color 0.2s var(--ease-ive);
  }

  .control-select:focus,
  .control-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .control-search {
    min-width: 190px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .articles-grid:not(.is-filtering) .is-featured-dup {
    display: none;
  }

  .grid-slot {
    display: flex;
  }

  .grid-slot > :global(*) {
    width: 100%;
  }

  .empty-state {
    margin-top: 2.5rem;
    padding: 3rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
    .featured-media {
      order: -1;
    }
  }

  @media (max-width: 760px) {
    .category-pills {
      border-radius: var(--radius-control);
    }

    .filter-controls {
      width: 100%;
    }

    .control-select,
    .control-search {
      width: 100%;
      min-width: 0;
    }
  }
</style>
