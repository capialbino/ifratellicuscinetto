---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAuthor } from '../data/authors';
import { CATEGORY_LABELS, CATEGORY_META, estimateReadingTime, formatDate, LEVEL_LABELS, type Locale } from '../utils/articles';
import { withBase } from '../utils/paths';
import { siteConfig } from '../utils/site-config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const articles = allArticles.filter((article) => article.data.language === locale);
const [featuredArticle, ...otherArticles] = articles;
const featuredAuthor = featuredArticle ? getAuthor(featuredArticle.data.author, locale) : null;
const featuredCat = featuredArticle ? CATEGORY_META[featuredArticle.data.category] : null;
const featuredReadTime = featuredArticle ? estimateReadingTime(featuredArticle.body) : 1;

const languageSwitchHref = locale === 'it' ? '/en/' : '/';
const isCentered = siteConfig.theme.heroAlign === 'center';
---

<BaseLayout
  title={locale === 'it'
    ? `${siteConfig.brand.name} — ${siteConfig.brand.subtitleIt}`
    : `${siteConfig.brand.name} — ${siteConfig.brand.subtitleEn}`}
  description={locale === 'it' ? siteConfig.hero.leadIt : siteConfig.hero.leadEn}
  activeNav="articoli"
  locale={locale}
  languageSwitchHref={languageSwitchHref}
>
  <!-- Editorial Masthead (compatto, niente stile landing commerciale) -->
  <section class:list={['masthead', { 'masthead-centered': isCentered }]}>
    <div class="container masthead-inner">
      <h1 class="masthead-title">
        {locale === 'it' ? siteConfig.hero.titleIt : siteConfig.hero.titleEn}
      </h1>
      <p class="masthead-lead">
        {locale === 'it' ? siteConfig.hero.leadIt : siteConfig.hero.leadEn}
      </p>
    </div>
  </section>

  <!-- Articolo in evidenza subito visibile above the fold -->
  {featuredArticle && featuredAuthor && featuredCat && (
    <section id="featured-section" class="container featured-section" aria-label={locale === 'it' ? 'Ultimo articolo' : 'Latest article'}>
      <a
        href={withBase(locale === 'it' ? `/articoli/${featuredArticle.id}` : `/en/articles/${featuredArticle.id.split('/').at(-1)}`)}
        class="featured-card"
      >
        <div class="featured-top">
          <span class="featured-label">{locale === 'it' ? 'Ultimo articolo' : 'Latest'}</span>
          <span class="meta-sep">·</span>
          <span class={`cat-eyebrow ${featuredCat.badgeClass}`}>
            <span class="cat-dot"></span>
            {CATEGORY_LABELS[locale][featuredArticle.data.category]}
          </span>
          <span class="meta-sep">·</span>
          <span class="featured-level">{LEVEL_LABELS[locale][featuredArticle.data.level]}</span>
        </div>

        <h2 class="featured-title">{featuredArticle.data.title}</h2>
        <p class="featured-desc">{featuredArticle.data.description}</p>

        <div class="featured-footer">
          <div class="author-mini">
            <span class="avatar-dot" style={`background:${featuredAuthor.accentColor}`}>
              {featuredAuthor.initials}
            </span>
            <div>
              <div class="author-name">{featuredAuthor.name}</div>
              <div class="featured-meta">
                <time datetime={featuredArticle.data.pubDate.toISOString()}>
                  {formatDate(featuredArticle.data.pubDate, locale)}
                </time>
                <span>·</span>
                <span>{featuredReadTime} {locale === 'it' ? 'min di lettura' : 'min read'}</span>
              </div>
            </div>
          </div>

          <span class="read-cta">
            {locale === 'it' ? 'Leggi l’articolo →' : 'Read article →'}
          </span>
        </div>
      </a>
    </section>
  )}

  <!-- Archivio e filtri -->
  <section class="container catalog-section" aria-label={locale === 'it' ? 'Archivio articoli' : 'Article archive'}>
    <div class="filter-bar">
      <div class="category-pills" role="tablist" aria-label={locale === 'it' ? 'Filtra per area' : 'Filter by topic'}>
        <button type="button" class="pill active" data-cat="all">{locale === 'it' ? 'Tutti' : 'All'} ({articles.length})</button>
        <button type="button" class="pill" data-cat="meccatronica-hybrid">{locale === 'it' ? 'Meccanica × AI' : 'Mechanical × AI'}</button>
        <button type="button" class="pill" data-cat="meccanica">{locale === 'it' ? 'Meccanica' : 'Mechanical Engineering'}</button>
        <button type="button" class="pill" data-cat="ai-software">AI &amp; Software</button>
      </div>

      <div class="filter-controls">
        <select id="author-filter" aria-label={locale === 'it' ? 'Filtra per autore' : 'Filter by author'} class="control-select">
          <option value="all">{locale === 'it' ? 'Tutti gli autori' : 'All authors'}</option>
          {(['federico-pappafava', 'alessandro-rossi', 'alessandro-capialbi'] as const).map((id) => {
            const a = getAuthor(id, locale);
            return <option value={a.id}>{a.name}</option>;
          })}
        </select>

        <input
          id="search-input"
          type="search"
          placeholder={locale === 'it' ? 'Cerca un argomento...' : 'Search a topic...'}
          aria-label={locale === 'it' ? 'Cerca articoli' : 'Search articles'}
          class="control-search"
        />
      </div>
    </div>

    <div id="articles-grid" class="articles-grid">
      {articles.map((article, idx) => (
        <div class:list={['grid-slot', { 'is-featured-dup': idx === 0 }]}>
          <ArticleCard article={article} locale={locale} />
        </div>
      ))}
    </div>

    <div id="empty-state" class="empty-state" hidden>
      {locale === 'it'
        ? 'Nessun articolo corrisponde ai filtri selezionati.'
        : 'No articles match your filters.'}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.getElementById('articles-grid');
    const featuredSection = document.getElementById('featured-section');
    const empty = document.getElementById('empty-state');
    const searchInput = document.getElementById('search-input');
    const authorSelect = document.getElementById('author-filter');
    const pills = Array.from(document.querySelectorAll('.pill[data-cat]'));
    if (!grid) return;

    const slots = Array.from(grid.querySelectorAll('.grid-slot'));
    let activeCat = 'all';

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const author = authorSelect?.value || 'all';
      const isFiltering = activeCat !== 'all' || author !== 'all' || Boolean(q);
      let visible = 0;

      if (featuredSection) {
        featuredSection.hidden = isFiltering;
      }

      for (const slot of slots) {
        const card = slot.querySelector('.article-card');
        if (!card) continue;
        const isDup = slot.classList.contains('is-featured-dup');
        if (!isFiltering && isDup) {
          slot.style.display = 'none';
          visible++;
          continue;
        }
        const catMatch = activeCat === 'all' || card.dataset.category === activeCat;
        const authorMatch = author === 'all' || card.dataset.author === author;
        const searchMatch = !q || (card.dataset.search || '').includes(q);
        const show = catMatch && authorMatch && searchMatch;
        slot.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      if (empty) empty.hidden = visible > 0;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        activeCat = pill.dataset.cat || 'all';
        applyFilters();
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    authorSelect?.addEventListener('change', applyFilters);
    applyFilters();
  })();
</script>

<style>
  .masthead {
    padding: clamp(2.5rem, 5vw, 3.75rem) 0 1.75rem;
  }

  .masthead-inner {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .masthead-centered .masthead-inner {
    align-items: center;
    text-align: center;
  }

  .masthead-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.6vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.036em;
    font-weight: 600;
    color: var(--text);
    text-wrap: balance;
  }

  .masthead-lead {
    margin: 0;
    max-width: 58ch;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* Featured lead article */
  .featured-section {
    padding-top: 0.5rem;
    padding-bottom: 2.25rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease-ive), box-shadow 0.35s var(--ease-ive), border-color 0.35s var(--ease-ive);
  }

  .featured-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .featured-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .featured-label {
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.7rem;
  }

  .meta-sep {
    color: var(--text-muted);
  }

  .cat-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-weight: 600;
    background: transparent !important;
    padding: 0;
  }

  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .featured-level {
    color: var(--text-muted);
  }

  .featured-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 3.2vw, 2.35rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.032em;
    color: var(--text);
    text-wrap: balance;
    transition: color 0.25s var(--ease-ive);
  }

  .featured-card:hover .featured-title {
    color: var(--accent);
  }

  .featured-desc {
    margin: 0;
    max-width: 64ch;
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .featured-footer {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .author-mini {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .avatar-dot {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.74rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .read-cta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    transition: transform 0.25s var(--ease-ive);
  }

  .featured-card:hover .read-cta {
    transform: translateX(3px);
  }

  /* Catalog */
  .catalog-section {
    padding-top: 0.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .category-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.28rem;
    border-radius: 980px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .pill {
    padding: 0.4rem 0.9rem;
    border-radius: 980px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease-ive);
  }

  .pill:hover {
    color: var(--text);
  }

  .pill.active {
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .control-select,
  .control-search {
    height: 36px;
    padding: 0 0.9rem;
    border-radius: 980px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    transition: border-color 0.2s var(--ease-ive);
  }

  .control-select:focus,
  .control-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .control-search {
    min-width: 190px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .grid-slot {
    display: flex;
  }

  .grid-slot > :global(*) {
    width: 100%;
  }

  .empty-state {
    margin-top: 2.5rem;
    padding: 3rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .category-pills {
      border-radius: var(--radius-control);
    }

    .filter-controls {
      width: 100%;
    }

    .control-select,
    .control-search {
      width: 100%;
      min-width: 0;
    }
  }
</style>
