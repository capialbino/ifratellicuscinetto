---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import type { Locale } from '../utils/articles';
import { withBase } from '../utils/paths';
import { buildThemeStyleVars, siteConfig } from '../utils/site-config';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'articoli' | 'chi-siamo';
  locale?: Locale;
  languageSwitchHref?: string;
}

const {
  title,
  description = 'Divulgazione tecnica su ingegneria meccanica, intelligenza artificiale e dove i due mondi si incontrano.',
  activeNav,
  locale = 'it',
  languageSwitchHref = locale === 'it' ? '/en/' : '/',
} = Astro.props;

const siteOrigin = Astro.site ?? 'https://ifratellicuscinetto.com';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const alternateURL = new URL(withBase(languageSwitchHref), siteOrigin);
const themeStyleVars = buildThemeStyleVars(siteConfig);
---

<!doctype html>
<html lang={locale} data-preset={siteConfig.theme.preset} style={themeStyleVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={locale} href={canonicalURL} />
    <link rel="alternate" hreflang={locale === 'it' ? 'en' : 'it'} href={alternateURL} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.brand.name} RSS`} href={withBase('/rss.xml')} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const preset = document.documentElement.dataset.preset;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && (preset === 'obsidian' || prefersDark))) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={withBase(locale === 'it' ? '/' : '/en/')} class="brand" aria-label={`${siteConfig.brand.name} - Home`}>
          {siteConfig.theme.showBearingMark && (
            <svg class="brand-mark" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <circle cx="32" cy="32" r="26" stroke="currentColor" stroke-width="2.4" />
              <circle cx="32" cy="32" r="12" stroke="currentColor" stroke-width="2.2" />
              <circle cx="32" cy="13" r="2.7" fill="currentColor" />
              <circle cx="48.5" cy="22.5" r="2.7" fill="var(--accent)" />
              <circle cx="48.5" cy="41.5" r="2.7" fill="currentColor" />
              <circle cx="32" cy="51" r="2.7" fill="var(--accent)" />
              <circle cx="15.5" cy="41.5" r="2.7" fill="currentColor" />
              <circle cx="15.5" cy="22.5" r="2.7" fill="var(--accent)" />
            </svg>
          )}
          <span class="brand-text">
            <span class="brand-title">{siteConfig.brand.name}</span>
            <span class="brand-sub">{locale === 'it' ? siteConfig.brand.subtitleIt : siteConfig.brand.subtitleEn}</span>
          </span>
        </a>

        <nav class="nav-group" aria-label={locale === 'it' ? 'Navigazione principale' : 'Main navigation'}>
          <a href={withBase(locale === 'it' ? '/' : '/en/')} class:list={['nav-link', { active: activeNav === 'articoli' }]}>{locale === 'it' ? 'Articoli' : 'Articles'}</a>
          <a href={withBase(locale === 'it' ? '/chi-siamo' : '/en/about')} class:list={['nav-link', { active: activeNav === 'chi-siamo' }]}>{locale === 'it' ? 'Chi siamo' : 'About'}</a>
          <a href={withBase('/rss.xml')} class="nav-link" title="RSS feed">RSS</a>
          <a href={withBase(languageSwitchHref)} class="nav-link" lang={locale === 'it' ? 'en' : 'it'} aria-label={locale === 'it' ? 'Switch to English' : 'Passa all’italiano'}>
            {locale === 'it' ? 'EN' : 'IT'}
          </a>
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label={locale === 'it' ? 'Cambia tema chiaro o scuro' : 'Toggle light or dark theme'}
            title={locale === 'it' ? 'Cambia tema' : 'Toggle theme'}
          >
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{siteConfig.brand.name}</strong> — {locale === 'it'
            ? siteConfig.footer.taglineIt
            : siteConfig.footer.taglineEn}
        </div>
        <div class="footer-links">
          <a href={withBase(locale === 'it' ? '/' : '/en/')}>{locale === 'it' ? 'Articoli' : 'Articles'}</a>
          <a href={withBase(locale === 'it' ? '/chi-siamo' : '/en/about')}>{locale === 'it' ? 'Chi siamo' : 'About'}</a>
          <a href={withBase(locale === 'it' ? '/privacy' : '/en/privacy')}>{locale === 'it' ? 'Privacy & Cookie' : 'Privacy & Cookies'}</a>
          <a href={withBase('/rss.xml')}>RSS</a>
          <a href={withBase('/admin')}>Admin</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          } catch {}
        });
      })();
    </script>
  </body>
</html>
