  // Sanitizza l'HTML incollato nell'editor visuale (rimuove stili inline, classi e script)
  visualEditorEl.addEventListener('paste', (e) => {
    e.preventDefault();
    const htmlData = e.clipboardData?.getData('text/html');
    const textData = e.clipboardData?.getData('text/plain') || '';
    if (htmlData) {
      const clean = DOMPurify.sanitize(htmlData, {
        FORBID_TAGS: ['style', 'script', 'iframe', 'object', 'embed'],
        FORBID_ATTR: ['style', 'class', 'id'],
      });
      document.execCommand('insertHTML', false, clean);
    } else if (textData) {
      document.execCommand('insertText', false, textData);
    }
  });

  // Click su una formula KaTeX in modalità visuale per modificarla
  visualEditorEl.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest('.math-chip, .math-block-chip') as HTMLElement | null;
    if (!chip) return;
    const currentTex = chip.dataset.tex || '';
    const updated = prompt('Modifica formula LaTeX:', currentTex);
    if (updated === null) return;
    const clean = updated.trim();
    if (!clean) {
      chip.remove();
      return;
    }
    const isBlock = chip.classList.contains('math-block-chip');
    chip.dataset.tex = clean;
    chip.innerHTML = katex.renderToString(clean, { displayMode: isBlock, throwOnError: false });
  });

  // Formatting toolbar (funziona sia in Visuale stile Word sia in Markdown)
  document.querySelectorAll('.tb-btn[data-insert]').forEach((btn) => {
    btn.addEventListener('mousedown', (e) => e.preventDefault());
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.insert;

      if (editorMode === 'visual') {
        visualEditorEl.focus();
        switch (type) {
          case 'p':
            document.execCommand('formatBlock', false, 'p');
            break;
          case 'h2':
            document.execCommand('formatBlock', false, 'h2');
            break;
          case 'h3':
            document.execCommand('formatBlock', false, 'h3');
            break;
          case 'bold':
            document.execCommand('bold');
            break;
          case 'italic':
            document.execCommand('italic');
            break;
          case 'list':
            document.execCommand('insertUnorderedList');
            break;
          case 'quote':
            document.execCommand('formatBlock', false, 'blockquote');
            break;
          case 'link': {
            const url = prompt('Inserisci URL del link:', 'https://');
            if (url) {
              const trimmed = url.trim();
              if (/^(https?:\/\/|mailto:|\/)/i.test(trimmed)) {
                document.execCommand('createLink', false, trimmed);
              } else {
                showBanner('URL non valido. Usa https://, http://, mailto: oppure un percorso relativo (/).', true);
              }
            }
            break;
          }
          case 'code':
            document.execCommand(
              'insertHTML',
              false,
              '<pre><code class="language-python"># Codice di esempio\nprint("I Fratelli Cuscinetto")</code></pre><p><br></p>'
            );
            break;
          case 'math-inline': {
            const tex = prompt('Formula matematica inline (LaTeX):', 'E = mc^2');
            if (tex && tex.trim()) {
              document.execCommand('insertHTML', false, `${createMathChipHtml(tex, false)}&nbsp;`);
            }
            break;
          }
          case 'math-block': {
            const tex = prompt('Formula matematica centrata (LaTeX):', 'p_0 = \\frac{3F}{2\\pi a b}');
            if (tex && tex.trim()) {
              document.execCommand('insertHTML', false, `${createMathChipHtml(tex, true)}<p><br></p>`);
            }
            break;
          }
          case 'table':
            document.execCommand(
              'insertHTML',
              false,
              '<table><thead><tr><th>Parametro</th><th>Valore</th><th>Unità</th></tr></thead><tbody><tr><td>Pressione</td><td>1.2</td><td>GPa</td></tr></tbody></table><p><br></p>'
            );
            break;
        }
        return;
      }

      switch (type) {
        case 'p':
          insertAtCursor('\n\n');
          break;
        case 'h2':
          insertAtCursor('\n## Titolo sezione\n');
          break;
        case 'h3':
          insertAtCursor('\n### Sottotitolo\n');
          break;
        case 'bold':
          insertAtCursor('testo in grassetto', '**', '**');
          break;
        case 'italic':
          insertAtCursor('testo in corsivo', '*', '*');
          break;
        case 'list':
          insertAtCursor('\n- Primo punto\n- Secondo punto\n');
          break;
        case 'quote':
          insertAtCursor('\n> **Nota tecnica:** scrivi qui il punto chiave.\n');
          break;
        case 'link':
          insertAtCursor('testo del link', '[', '](https://)');
          break;
        case 'code':
          insertAtCursor('\n```python\n# Codice di esempio\nprint("I Fratelli Cuscinetto")\n```\n');
          break;
        case 'math-inline':
          insertAtCursor('E = mc^2', '$', '$');
          break;
        case 'math-block':
          insertAtCursor('\n$$\np_0 = \\frac{3F}{2\\pi a b}\n$$\n');
          break;
        case 'table':
          insertAtCursor('\n| Parametro | Valore | Unità |\n| :--- | :---: | :--- |\n| Pressione | 1.2 | GPa |\n');
          break;
      }
    });
  });

