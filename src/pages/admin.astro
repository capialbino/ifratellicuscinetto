  // --- Studio Tabs & Live Design Customizer ---
  const panelArticles = document.getElementById('panel-articles')!;
  const panelDesign = document.getElementById('panel-design')!;
  const studioTabs = document.querySelectorAll('.studio-tab[data-studio-tab]');
  const designBanner = document.getElementById('design-banner')!;
  const saveDesignBtn = document.getElementById('save-design-btn') as HTMLButtonElement;
  const resetDesignBtn = document.getElementById('reset-design-btn') as HTMLButtonElement;

  const PRESET_DEFAULTS: Record<string, { accentLight: string; accentDark: string }> = {
    alabaster: { accentLight: '#0071e3', accentDark: '#2997ff' },
    ceramic: { accentLight: '#c85a17', accentDark: '#f0883e' },
    graphite: { accentLight: '#1d1d1f', accentDark: '#0a84ff' },
    obsidian: { accentLight: '#2997ff', accentDark: '#2997ff' },
  };

  let currentSiteConfig = JSON.parse(root?.dataset.initialConfig || '{}');
  let siteConfigSha: string | null = null;
  let designLoadedFromRepo = false;

  const cfgEl = {
    accentLight: document.getElementById('cfg-accent-light') as HTMLInputElement,
    accentLightHex: document.getElementById('cfg-accent-light-hex') as HTMLInputElement,
    accentDark: document.getElementById('cfg-accent-dark') as HTMLInputElement,
    accentDarkHex: document.getElementById('cfg-accent-dark-hex') as HTMLInputElement,
    headingFont: document.getElementById('cfg-heading-font') as HTMLSelectElement,
    proseFont: document.getElementById('cfg-prose-font') as HTMLSelectElement,
    radius: document.getElementById('cfg-radius') as HTMLSelectElement,
    spacing: document.getElementById('cfg-spacing') as HTMLSelectElement,
    showBearing: document.getElementById('cfg-show-bearing') as HTMLInputElement,
    brandName: document.getElementById('cfg-brand-name') as HTMLInputElement,
    brandSubIt: document.getElementById('cfg-brand-sub-it') as HTMLInputElement,
    brandSubEn: document.getElementById('cfg-brand-sub-en') as HTMLInputElement,
    leadIt: document.getElementById('cfg-lead-it') as HTMLTextAreaElement,
    leadEn: document.getElementById('cfg-lead-en') as HTMLTextAreaElement,
    footerIt: document.getElementById('cfg-footer-it') as HTMLInputElement,
    footerEn: document.getElementById('cfg-footer-en') as HTMLInputElement,
  };

  function showDesignBanner(msg: string, isError = false) {
    designBanner.textContent = msg;
    designBanner.classList.toggle('is-error', isError);
    designBanner.hidden = false;
  }

  function applyLiveDesignPreview(cfg: any) {
    const html = document.documentElement;
    html.dataset.preset = cfg.theme.preset;
    html.style.setProperty('--user-accent-light', cfg.theme.accentLight);
    html.style.setProperty('--user-accent-dark', cfg.theme.accentDark);
    const radMap: Record<string, [string, string]> = {
      sharp: ['10px', '8px'],
      ive: ['22px', '12px'],
      soft: ['28px', '16px'],
    };
    const [cardR, ctrlR] = radMap[cfg.theme.radius] || radMap.ive;
    html.style.setProperty('--radius-card', cardR);
    html.style.setProperty('--radius-control', ctrlR);
    html.style.setProperty(
      '--font-heading',
      cfg.theme.headingFont === 'serif' ? 'var(--font-serif)' : 'var(--font-display)'
    );
    html.style.setProperty(
      '--font-prose',
      cfg.theme.proseFont === 'serif' ? 'var(--font-serif)' : 'var(--font-sans)'
    );

    document.querySelectorAll('.preset-chip[data-preset-pick]').forEach((el) => {
      el.classList.toggle('active', (el as HTMLElement).dataset.presetPick === cfg.theme.preset);
    });
  }

  function populateDesignForm(cfg: any) {
    cfgEl.accentLight.value = cfg.theme.accentLight;
    cfgEl.accentLightHex.value = cfg.theme.accentLight;
    cfgEl.accentDark.value = cfg.theme.accentDark;
    cfgEl.accentDarkHex.value = cfg.theme.accentDark;
    cfgEl.headingFont.value = cfg.theme.headingFont;
    cfgEl.proseFont.value = cfg.theme.proseFont;
    cfgEl.radius.value = cfg.theme.radius;
    cfgEl.spacing.value = cfg.theme.spacing;
    cfgEl.showBearing.checked = Boolean(cfg.theme.showBearingMark);

    cfgEl.brandName.value = cfg.brand.name || '';
    cfgEl.brandSubIt.value = cfg.brand.subtitleIt || '';
    cfgEl.brandSubEn.value = cfg.brand.subtitleEn || '';
    cfgEl.leadIt.value = cfg.hero?.leadIt || '';
    cfgEl.leadEn.value = cfg.hero?.leadEn || '';
    cfgEl.footerIt.value = cfg.footer.taglineIt || '';
    cfgEl.footerEn.value = cfg.footer.taglineEn || '';
    applyLiveDesignPreview(cfg);
  }

  function readDesignFormIntoConfig() {
    currentSiteConfig = {
      ...currentSiteConfig,
      brand: {
        ...currentSiteConfig.brand,
        name: cfgEl.brandName.value.trim() || 'I Fratelli Cuscinetto',
        subtitleIt: cfgEl.brandSubIt.value.trim(),
        subtitleEn: cfgEl.brandSubEn.value.trim(),
      },
      theme: {
        ...currentSiteConfig.theme,
        accentLight: cfgEl.accentLightHex.value.trim() || '#0071e3',
        accentDark: cfgEl.accentDarkHex.value.trim() || '#2997ff',
        headingFont: cfgEl.headingFont.value,
        proseFont: cfgEl.proseFont.value,
        radius: cfgEl.radius.value,
        spacing: cfgEl.spacing.value,
        showBearingMark: cfgEl.showBearing.checked,
      },
      hero: {
        ...currentSiteConfig.hero,
        leadIt: cfgEl.leadIt.value.trim(),
        leadEn: cfgEl.leadEn.value.trim(),
      },
      footer: {
        ...currentSiteConfig.footer,
        taglineIt: cfgEl.footerIt.value.trim(),
        taglineEn: cfgEl.footerEn.value.trim(),
      },
    };
    applyLiveDesignPreview(currentSiteConfig);
    return currentSiteConfig;
  }

  async function loadSiteConfigFromRepo() {
    if (designLoadedFromRepo) return;
    try {
      const res = await fetch(`${API_BASE}/site-config`);
      if (res.ok) {
        const data = await res.json();
        currentSiteConfig = data.config;
        siteConfigSha = data.sha;
        designLoadedFromRepo = true;
      }
    } catch {
      // Usa initialConfig come fallback
    }
    populateDesignForm(currentSiteConfig);
  }

  async function saveSiteConfig() {
    const cfg = readDesignFormIntoConfig();
    saveDesignBtn.disabled = true;
    saveDesignBtn.textContent = 'Salvataggio...';
    designBanner.hidden = true;

    try {
      const res = await fetch(`${API_BASE}/site-config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config: cfg, sha: siteConfigSha || undefined }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore salvataggio design');
      siteConfigSha = data.sha || siteConfigSha;
      showDesignBanner('Design e testi salvati su GitHub! Il sito si aggiornerà entro 1-2 minuti.');
    } catch (err: any) {
      showDesignBanner(err?.message || 'Errore durante il salvataggio.', true);
    } finally {
      saveDesignBtn.disabled = false;
      saveDesignBtn.textContent = 'Salva design e pubblica';
    }
  }

  studioTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      studioTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const target = (tab as HTMLElement).dataset.studioTab;
      const isDesign = target === 'design';
      panelArticles.hidden = isDesign;
      panelDesign.hidden = !isDesign;
      if (isDesign) loadSiteConfigFromRepo();
    });
  });

  document.querySelectorAll('.preset-chip[data-preset-pick]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const preset = (btn as HTMLElement).dataset.presetPick || 'alabaster';
      const colors = PRESET_DEFAULTS[preset] || PRESET_DEFAULTS.alabaster;
      currentSiteConfig.theme.preset = preset;
      currentSiteConfig.theme.accentLight = colors.accentLight;
      currentSiteConfig.theme.accentDark = colors.accentDark;
      populateDesignForm(currentSiteConfig);
    });
  });

  cfgEl.accentLight.addEventListener('input', () => {
    cfgEl.accentLightHex.value = cfgEl.accentLight.value;
    readDesignFormIntoConfig();
  });
  cfgEl.accentLightHex.addEventListener('input', () => {
    if (/^#[0-9a-f]{6}$/i.test(cfgEl.accentLightHex.value)) {
      cfgEl.accentLight.value = cfgEl.accentLightHex.value;
      readDesignFormIntoConfig();
    }
  });
  cfgEl.accentDark.addEventListener('input', () => {
    cfgEl.accentDarkHex.value = cfgEl.accentDark.value;
    readDesignFormIntoConfig();
  });
  cfgEl.accentDarkHex.addEventListener('input', () => {
    if (/^#[0-9a-f]{6}$/i.test(cfgEl.accentDarkHex.value)) {
      cfgEl.accentDark.value = cfgEl.accentDarkHex.value;
      readDesignFormIntoConfig();
    }
  });

  [cfgEl.headingFont, cfgEl.proseFont, cfgEl.radius, cfgEl.spacing, cfgEl.showBearing].forEach(
    (el) => el.addEventListener('change', readDesignFormIntoConfig)
  );

  saveDesignBtn.addEventListener('click', saveSiteConfig);
  resetDesignBtn.addEventListener('click', () => {
    currentSiteConfig.theme = {
      preset: 'alabaster',
      accentLight: '#0071e3',
      accentDark: '#2997ff',
      headingFont: 'sans',
      proseFont: 'sans',
      radius: 'ive',
      spacing: 'airy',
      heroAlign: 'center',
      showBearingMark: true,
    };
    populateDesignForm(currentSiteConfig);
  });

  populateDesignForm(currentSiteConfig);
  initAdmin();
</script>

