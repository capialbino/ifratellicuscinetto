---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHORS } from '../data/authors';
import { withBase } from '../utils/paths';
import { siteConfig } from '../utils/site-config';

const authorsList = Object.values(AUTHORS);
const apiBase = withBase('/api/admin');
const initialConfigJson = JSON.stringify(siteConfig);
---

<BaseLayout
  title={`Area Redazione — ${siteConfig.brand.name}`}
  description="Pannello editoriale per scrivere articoli e personalizzare il design del sito."
  locale="it"
>
  <div id="admin-root" class="admin-shell" data-api-base={apiBase} data-initial-config={initialConfigJson}>
    <!-- Login View -->
    <section id="login-view" class="container login-wrap">
      <div class="login-card">
        <div class="login-head">
          <h1>Accedi</h1>
        </div>

        <form id="cf-login-form" class="login-form">
          <label class="field">
            <span>Username</span>
            <input
              id="login-author"
              type="text"
              list="authors-datalist"
              placeholder="nome-cognome"
              autocomplete="username"
              required
            />
            <datalist id="authors-datalist">
              {authorsList.map((a) => (
                <option value={a.id}>{a.name}</option>
              ))}
            </datalist>
          </label>

          <label class="field">
            <span>Password</span>
            <input
              id="login-password"
              type="password"
              placeholder="Password"
              autocomplete="current-password"
              required
            />
          </label>

          <button type="submit" class="btn btn-primary" id="cf-login-btn">
            Accedi
          </button>
        </form>

        <div id="login-error" class="error-box" hidden></div>
      </div>
    </section>

    <!-- Studio View -->
    <section id="studio-view" class="studio-wrap" hidden>
      <div class="studio-topbar">
        <div class="container studio-topbar-inner">
          <div class="studio-status">
            <span id="studio-avatar" class="profile-avatar-circle" title="Profilo" aria-label="Profilo"></span>
          </div>

          <div class="studio-tabs" role="tablist">
            <button type="button" class="studio-tab active" data-studio-tab="articles">Articoli</button>
            <button type="button" class="studio-tab" data-studio-tab="design">Aspetto &amp; Testi</button>
          </div>

          <div class="studio-actions">
            <button type="button" id="new-article-btn" class="btn btn-secondary">
              + Nuovo articolo
            </button>
            <button type="button" id="logout-btn" class="btn btn-ghost">
              Esci
            </button>
          </div>
        </div>
      </div>

      <div id="panel-articles" class="container studio-grid">
        <!-- Sidebar elenco articoli -->
        <aside class="articles-sidebar">
          <div class="sidebar-header">
            <h2>Articoli (<span id="articles-count">0</span>)</h2>
            <button type="button" id="refresh-list-btn" class="btn-icon" title="Aggiorna elenco">
              ↻
            </button>
          </div>
          <div id="articles-list" class="articles-list">
            <div class="muted small">Caricamento articoli...</div>
          </div>
        </aside>

        <!-- Editor principale -->
        <div class="editor-panel">
          <div id="save-banner" class="toast-banner" hidden></div>

          <div class="meta-grid">
            <label class="field field-wide">
              <span>Titolo articolo *</span>
              <input
                id="art-title"
                type="text"
                placeholder="Es. Come funzionano i cuscinetti magnetici attivi"
                required
              />
            </label>

            <input id="art-slug" type="hidden" />

            <label class="field">
              <span>Autore *</span>
              <select id="art-author">
                {authorsList.map((a) => (
                  <option value={a.id}>{a.name}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span>Categoria *</span>
              <select id="art-category">
                <option value="Meccatronica & Hybrid">Meccanica × AI</option>
                <option value="Meccanica">Meccanica</option>
                <option value="AI & Software">AI &amp; Software</option>
              </select>
            </label>

            <label class="field">
              <span>Livello tecnico</span>
              <select id="art-level">
                <option value="Divulgativo">Divulgativo</option>
                <option value="Intermedio" selected>Intermedio</option>
                <option value="Tecnico / Avanzato">Tecnico / Avanzato</option>
              </select>
            </label>

            <label class="field">
              <span>Data pubblicazione</span>
              <input id="art-date" type="date" />
            </label>

            <input id="art-tags" type="hidden" />
            <input id="art-desc" type="hidden" />
          </div>

          <!-- Toolbar & Preview switcher -->
          <div class="editor-toolbar-wrap">
            <div class="format-toolbar" role="toolbar" aria-label="Strumenti di formattazione">
              <button type="button" class="tb-btn" data-insert="h2" title="Titolo sezione">H2</button>
              <button type="button" class="tb-btn" data-insert="h3" title="Sottotitolo">H3</button>
              <button type="button" class="tb-btn" data-insert="bold" title="Grassetto"><strong>B</strong></button>
              <button type="button" class="tb-btn" data-insert="italic" title="Corsivo"><em>I</em></button>
              <button type="button" class="tb-btn" data-insert="list" title="Elenco puntato">• Elenco</button>
              <button type="button" class="tb-btn" data-insert="quote" title="Nota / Citazione">❝ Nota</button>
              <button type="button" class="tb-btn" data-insert="link" title="Link">🔗 Link</button>
              <button type="button" class="tb-btn" data-insert="code" title="Blocco codice">{`</>`}</button>
              <button type="button" class="tb-btn" data-insert="math-inline" title="Formula inline">$x$</button>
              <button type="button" class="tb-btn" data-insert="math-block" title="Formula centrata">$$ ∑ $$</button>
              <button type="button" class="tb-btn" data-insert="table" title="Tabella">⊞ Tabella</button>
              <label class="tb-btn tb-upload" title="Carica immagine dal PC">
                🖼 Immagine
                <input id="image-upload-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden />
              </label>
              <button type="button" id="ai-format-btn" class="tb-btn tb-ai" title="Impagina in Markdown e converte le formule in LaTeX">
                ✨ Formatta &amp; LaTeX
              </button>
              <button type="button" id="ai-undo-btn" class="tb-btn" hidden title="Ripristina il testo prima dell’ultima modifica AI">
                ↩ Ripristina
              </button>
            </div>

            <div class="view-tabs" role="tablist">
              <button type="button" class="view-tab active" data-view="split">Diviso</button>
              <button type="button" class="view-tab" data-view="write">Scrivi</button>
              <button type="button" class="view-tab" data-view="preview">Anteprima</button>
            </div>
          </div>

          <div id="workspace-panes" class="workspace-panes view-split">
            <textarea
              id="art-body"
              class="markdown-input"
              placeholder="Scrivi qui l'articolo in italiano...&#10;&#10;Suggerimento: usa i pulsanti qui sopra per titoli, formule matematiche ($...$ o $$...$$), codice e immagini. Quando pubblichi, la versione inglese verrà generata in automatico!"
            ></textarea>

            <div id="live-preview" class="preview-pane prose"></div>
          </div>

          <div class="publish-bar">
            <label class="checkbox-inline">
              <input id="art-draft" type="checkbox" />
              <span>Salva come bozza (non visibile ai lettori)</span>
            </label>

            <div class="publish-buttons">
              <button type="button" id="delete-btn" class="btn btn-danger" hidden>
                Elimina
              </button>
              <button type="button" id="publish-btn" class="btn btn-primary">
                Pubblica articolo
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Pannello Aspetto & Testi (Design Customizer) -->
      <div id="panel-design" class="container design-panel-wrap" hidden>
        <div id="design-banner" class="toast-banner" hidden></div>

        <div class="design-grid">
          <div class="design-card">
            <h2>Superficie &amp; Palette</h2>
            <p class="muted small">Le modifiche si applicano subito in anteprima su questa pagina. Premi Salva per pubblicarle sul sito.</p>

            <div class="preset-grid">
              <button type="button" class="preset-chip" data-preset-pick="alabaster">
                <span class="swatch-pair"><i style="background:#f5f5f7"></i><i style="background:#0071e3"></i></span>
                <span>Alabaster Titanium</span>
              </button>
              <button type="button" class="preset-chip" data-preset-pick="ceramic">
                <span class="swatch-pair"><i style="background:#f6f4ef"></i><i style="background:#c85a17"></i></span>
                <span>Warm Ceramic</span>
              </button>
              <button type="button" class="preset-chip" data-preset-pick="graphite">
                <span class="swatch-pair"><i style="background:#eef0f4"></i><i style="background:#1d1d1f"></i></span>
                <span>Cool Graphite</span>
              </button>
              <button type="button" class="preset-chip" data-preset-pick="obsidian">
                <span class="swatch-pair"><i style="background:#000000"></i><i style="background:#2997ff"></i></span>
                <span>Obsidian Black</span>
              </button>
            </div>

            <div class="meta-grid" style="margin-top:1.1rem">
              <label class="field">
                <span>Colore accento (Chiaro)</span>
                <div class="color-row">
                  <input id="cfg-accent-light" type="color" value="#0071e3" />
                  <input id="cfg-accent-light-hex" type="text" value="#0071e3" />
                </div>
              </label>

              <label class="field">
                <span>Colore accento (Scuro)</span>
                <div class="color-row">
                  <input id="cfg-accent-dark" type="color" value="#2997ff" />
                  <input id="cfg-accent-dark-hex" type="text" value="#2997ff" />
                </div>
              </label>

              <label class="field">
                <span>Font titoli</span>
                <select id="cfg-heading-font">
                  <option value="sans">SF / Inter Sans (Apple)</option>
                  <option value="serif">Source Serif (Editoriale)</option>
                </select>
              </label>

              <label class="field">
                <span>Font testo articoli</span>
                <select id="cfg-prose-font">
                  <option value="sans">SF / Inter Sans (Pulito)</option>
                  <option value="serif">Source Serif (Rivista)</option>
                </select>
              </label>

              <label class="field">
                <span>Raggio angoli</span>
                <select id="cfg-radius">
                  <option value="sharp">Precisione (10px)</option>
                  <option value="ive">Jony Ive (22px)</option>
                  <option value="soft">Morbido (28px)</option>
                </select>
              </label>

              <label class="field">
                <span>Spaziatura / Respiro</span>
                <select id="cfg-spacing">
                  <option value="airy">Arioso (Apple)</option>
                  <option value="balanced">Bilanciato</option>
                  <option value="compact">Compatto</option>
                </select>
              </label>

              <label class="field">
                <span>Allineamento Hero</span>
                <select id="cfg-hero-align">
                  <option value="center">Centrato</option>
                  <option value="left">Allineato a sinistra</option>
                </select>
              </label>

              <div class="field" style="justify-content:center;gap:0.6rem">
                <label class="checkbox-inline">
                  <input id="cfg-show-bearing" type="checkbox" checked />
                  <span>Mostra logo cuscinetto</span>
                </label>
                <label class="checkbox-inline">
                  <input id="cfg-show-pillars" type="checkbox" checked />
                  <span>Mostra 3 pilastri in home</span>
                </label>
              </div>
            </div>
          </div>

          <div class="design-card">
            <h2>Testi Home &amp; Brand</h2>
            <div class="meta-grid">
              <label class="field field-wide">
                <span>Nome del sito</span>
                <input id="cfg-brand-name" type="text" />
              </label>
              <label class="field">
                <span>Sottotitolo header (IT)</span>
                <input id="cfg-brand-sub-it" type="text" />
              </label>
              <label class="field">
                <span>Sottotitolo header (EN)</span>
                <input id="cfg-brand-sub-en" type="text" />
              </label>
              <label class="field">
                <span>Occhiello Hero (IT)</span>
                <input id="cfg-kicker-it" type="text" />
              </label>
              <label class="field">
                <span>Occhiello Hero (EN)</span>
                <input id="cfg-kicker-en" type="text" />
              </label>
              <label class="field field-wide">
                <span>Titolo Hero (IT)</span>
                <input id="cfg-title-it" type="text" />
              </label>
              <label class="field field-wide">
                <span>Titolo Hero (EN)</span>
                <input id="cfg-title-en" type="text" />
              </label>
              <label class="field field-wide">
                <span>Descrizione Hero (IT)</span>
                <textarea id="cfg-lead-it" rows="2"></textarea>
              </label>
              <label class="field field-wide">
                <span>Descrizione Hero (EN)</span>
                <textarea id="cfg-lead-en" rows="2"></textarea>
              </label>
              <label class="field">
                <span>Tagline Footer (IT)</span>
                <input id="cfg-footer-it" type="text" />
              </label>
              <label class="field">
                <span>Tagline Footer (EN)</span>
                <input id="cfg-footer-en" type="text" />
              </label>
            </div>

            <div class="publish-bar" style="margin-top:1.25rem">
              <button type="button" id="reset-design-btn" class="btn btn-secondary">
                Ripristina default Jony Ive
              </button>
              <button type="button" id="save-design-btn" class="btn btn-primary">
                Salva design e pubblica
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { marked } from 'marked';
  import katex from 'katex';

  marked.setOptions({ gfm: true, breaks: false });

  const root = document.getElementById('admin-root');
  const API_BASE = root?.dataset.apiBase || '/api/admin';

  const AUTHOR_META: Record<string, { name: string; initials: string; color: string }> = {
    'federico-pappafava': { name: 'Federico Pappafava', initials: 'FP', color: '#c85a17' },
    'alessandro-rossi': { name: 'Alessandro Rossi', initials: 'AR', color: '#0f766e' },
    'alessandro-capialbi': { name: 'Alessandro Capialbi', initials: 'AC', color: '#2563eb' },
  };
  const AUTHOR_NAMES: Record<string, string> = {
    'federico-pappafava': 'Federico Pappafava',
    'alessandro-rossi': 'Alessandro Rossi',
    'alessandro-capialbi': 'Alessandro Capialbi',
  };

  // Elements
  const loginView = document.getElementById('login-view')!;
  const studioView = document.getElementById('studio-view')!;
  const cfLoginForm = document.getElementById('cf-login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error')!;

  const studioAvatar = document.getElementById('studio-avatar')!;
  const articlesListEl = document.getElementById('articles-list')!;
  const articlesCountEl = document.getElementById('articles-count')!;
  const saveBanner = document.getElementById('save-banner')!;

  const titleInput = document.getElementById('art-title') as HTMLInputElement;
  const slugInput = document.getElementById('art-slug') as HTMLInputElement;
  const authorSelect = document.getElementById('art-author') as HTMLSelectElement;
  const categorySelect = document.getElementById('art-category') as HTMLSelectElement;
  const levelSelect = document.getElementById('art-level') as HTMLSelectElement;
  const dateInput = document.getElementById('art-date') as HTMLInputElement;
  const tagsInput = document.getElementById('art-tags') as HTMLInputElement;
  const descInput = document.getElementById('art-desc') as HTMLTextAreaElement;
  const bodyInput = document.getElementById('art-body') as HTMLTextAreaElement;
  const draftCheckbox = document.getElementById('art-draft') as HTMLInputElement;
  const livePreviewEl = document.getElementById('live-preview')!;
  const workspacePanes = document.getElementById('workspace-panes')!;
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
  const imageUploadInput = document.getElementById('image-upload-input') as HTMLInputElement;

  interface ArticleRecord {
    slug: string;
    path: string;
    sha: string;
    hasEnglish: boolean;
    frontmatter: {
      title: string;
      description: string;
      pubDate: string;
      author: string;
      category: string;
      tags: string[];
      level: string;
      draft: boolean;
    };
    body: string;
  }

  let backendMode: 'cloudflare' | 'github-direct' = 'cloudflare';
  let currentAuthor = 'alessandro-capialbi';
  let ghCreds: { token: string; repo: string; branch: string } | null = null;
  let articlesCache: ArticleRecord[] = [];
  let editingSlug: string | null = null;
  let editingSha: string | null = null;
  let slugManuallyEdited = false;

  function showError(msg: string) {
    loginError.textContent = msg;
    loginError.hidden = false;
  }

  function clearError() {
    loginError.hidden = true;
    loginError.textContent = '';
  }

  function showBanner(msg: string, isError = false) {
    saveBanner.textContent = msg;
    saveBanner.classList.toggle('is-error', isError);
    saveBanner.hidden = false;
  }

  function hideBanner() {
    saveBanner.hidden = true;
  }

  function slugify(str: string): string {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 90);
  }

  function utf8ToBase64(text: string): string {
    const bytes = new TextEncoder().encode(text);
    let binary = '';
    for (let i = 0; i < bytes.length; i += 0x8000) {
      binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
    }
    return btoa(binary);
  }

  function base64ToUtf8(b64: string): string {
    const binary = atob(b64.replace(/\s+/g, ''));
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  function parseMarkdownFrontmatter(raw: string) {
    const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!m) return { frontmatter: {} as Record<string, unknown>, body: raw };
    const fm: Record<string, unknown> = {};
    for (const line of m[1].split(/\r?\n/)) {
      const idx = line.indexOf(':');
      if (idx <= 0) continue;
      const k = line.slice(0, idx).trim();
      const v = line.slice(idx + 1).trim();
      if (v === 'true') fm[k] = true;
      else if (v === 'false') fm[k] = false;
      else if (v.startsWith('[') && v.endsWith(']')) {
        try {
          fm[k] = JSON.parse(v);
        } catch {
          fm[k] = [];
        }
      } else if (v.startsWith('"') && v.endsWith('"')) {
        try {
          fm[k] = JSON.parse(v);
        } catch {
          fm[k] = v.slice(1, -1);
        }
      } else {
        fm[k] = v.replace(/^'|'$/g, '');
      }
    }
    return { frontmatter: fm, body: m[2].replace(/^\r?\n/, '') };
  }

  function serializeMarkdown(data: {
    title: string;
    description: string;
    pubDate: string;
    author: string;
    category: string;
    tags: string[];
    level: string;
    draft: boolean;
    body: string;
  }) {
    return [
      '---',
      'language: "it"',
      `title: ${JSON.stringify(data.title)}`,
      `description: ${JSON.stringify(data.description)}`,
      `pubDate: ${data.pubDate}`,
      `author: ${JSON.stringify(data.author)}`,
      `category: ${JSON.stringify(data.category)}`,
      `tags: ${JSON.stringify(data.tags)}`,
      `level: ${JSON.stringify(data.level)}`,
      `draft: ${data.draft ? 'true' : 'false'}`,
      '---',
      '',
      data.body.trim(),
      '',
    ].join('\n');
  }

  function renderPreview() {
    const raw = bodyInput.value || '';
    const mathTokens: string[] = [];

    // Protegge blocchi di codice da sostituzioni LaTeX
    const codeTokens: string[] = [];
    let safe = raw.replace(/```[\s\S]*?```/g, (block) => {
      const id = codeTokens.push(block) - 1;
      return `@@CODE_BLOCK_${id}@@`;
    });

    // Render $$...$$ display math
    safe = safe.replace(/\$\$([\s\S]+?)\$\$/g, (_, tex) => {
      try {
        const html = katex.renderToString(tex.trim(), { displayMode: true, throwOnError: false });
        const id = mathTokens.push(html) - 1;
        return `\n\n<div class="katex-preview-block">@@MATH_${id}@@</div>\n\n`;
      } catch {
        return _;
      }
    });

    // Render $...$ inline math
    safe = safe.replace(/(^|[^\\$])\$([^\n$]+?)\$/g, (full, prefix, tex) => {
      try {
        const html = katex.renderToString(tex.trim(), { displayMode: false, throwOnError: false });
        const id = mathTokens.push(html) - 1;
        return `${prefix}@@MATH_${id}@@`;
      } catch {
        return full;
      }
    });

    // Ripristina i blocchi di codice prima di marked
    safe = safe.replace(/@@CODE_BLOCK_(\d+)@@/g, (_, idx) => codeTokens[Number(idx)] || '');

    let html = marked.parse(safe) as string;
    html = html
      .replace(/<(script|iframe|object|embed|style)[\s\S]*?<\/\1>/gi, '')
      .replace(/<(script|iframe|object|embed)\b[^>]*\/?>/gi, '')
      .replace(/\son[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
      .replace(/javascript:/gi, '');
    html = html.replace(/@@MATH_(\d+)@@/g, (_, idx) => mathTokens[Number(idx)] || '');

    livePreviewEl.innerHTML = html || '<p class="muted">L’anteprima apparirà qui mentre scrivi...</p>';
  }

  function resetFormForNew() {
    editingSlug = null;
    editingSha = null;
    slugManuallyEdited = false;
    titleInput.value = '';
    slugInput.value = '';
    slugInput.disabled = false;
    authorSelect.value = currentAuthor;
    categorySelect.value = 'Meccatronica & Hybrid';
    levelSelect.value = 'Intermedio';
    dateInput.value = new Date().toISOString().slice(0, 10);
    tagsInput.value = '';
    descInput.value = '';
    bodyInput.value = '';
    draftCheckbox.checked = false;
    publishBtn.textContent = 'Pubblica articolo';
    deleteBtn.hidden = true;
    hideBanner();
    renderArticlesList();
    renderPreview();
  }

  function loadArticleIntoForm(art: ArticleRecord) {
    editingSlug = art.slug;
    editingSha = art.sha;
    slugManuallyEdited = true;
    titleInput.value = art.frontmatter.title;
    slugInput.value = art.slug;
    slugInput.disabled = true;
    authorSelect.value = art.frontmatter.author;
    categorySelect.value = art.frontmatter.category;
    levelSelect.value = art.frontmatter.level;
    dateInput.value = art.frontmatter.pubDate || new Date().toISOString().slice(0, 10);
    tagsInput.value = (art.frontmatter.tags || []).join(', ');
    descInput.value = art.frontmatter.description;
    bodyInput.value = art.body;
    draftCheckbox.checked = Boolean(art.frontmatter.draft);
    publishBtn.textContent = 'Salva modifiche';
    deleteBtn.hidden = false;
    hideBanner();
    renderArticlesList();
    renderPreview();
  }

  function renderArticlesList() {
    articlesCountEl.textContent = String(articlesCache.length);
    if (articlesCache.length === 0) {
      articlesListEl.innerHTML = '<div class="muted small">Nessun articolo trovato.</div>';
      return;
    }

    articlesListEl.innerHTML = '';
    for (const art of articlesCache) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `article-item ${editingSlug === art.slug ? 'active' : ''}`;

      const statusBadge = art.frontmatter.draft
        ? '<span class="mini-badge warn">Bozza</span>'
        : '<span class="mini-badge ok">Pubblicato</span>';
      const enBadge = art.hasEnglish
        ? '<span class="mini-badge en">IT + EN</span>'
        : '<span class="mini-badge">Solo IT</span>';

      btn.innerHTML = `
        <div class="item-title">${escapeHtml(art.frontmatter.title)}</div>
        <div class="item-meta">
          <span>${escapeHtml(AUTHOR_NAMES[art.frontmatter.author] || art.frontmatter.author)}</span>
          <span>·</span>
          <span>${escapeHtml(art.frontmatter.pubDate)}</span>
        </div>
        <div class="item-badges">${statusBadge}${enBadge}</div>
      `;
      btn.addEventListener('click', () => loadArticleIntoForm(art));
      articlesListEl.appendChild(btn);
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // --- API Layer (Cloudflare backend vs GitHub Direct) ---

  async function ghApi(path: string, init: RequestInit = {}) {
    if (!ghCreds) throw new Error('Token GitHub non configurato');
    const url = `https://api.github.com/repos/${ghCreds.repo}${path}`;
    return fetch(url, {
      ...init,
      headers: {
        Accept: 'application/vnd.github+json',
        Authorization: `Bearer ${ghCreds.token}`,
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init.headers || {}),
      },
    });
  }

  async function fetchArticles() {
    articlesListEl.innerHTML = '<div class="muted small">Caricamento articoli...</div>';
    if (backendMode === 'cloudflare') {
      const res = await fetch(`${API_BASE}/articles`);
      if (res.status === 401) {
        showLoginScreen();
        return;
      }
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore caricamento articoli');
      articlesCache = data.articles || [];
    } else {
      const branch = ghCreds!.branch;
      const [itRes, enRes] = await Promise.all([
        ghApi(`/contents/src/content/articles?ref=${encodeURIComponent(branch)}`),
        ghApi(`/contents/src/content/articles/en?ref=${encodeURIComponent(branch)}`),
      ]);
      if (!itRes.ok) throw new Error('Impossibile leggere il repo GitHub. Controlla token e permessi.');
      const itList = await itRes.json();
      const enList = enRes.ok ? await enRes.json() : [];
      const enSlugs = new Set(
        (Array.isArray(enList) ? enList : [])
          .filter((f: any) => f.type === 'file' && /\.mdx?$/.test(f.name))
          .map((f: any) => f.name.replace(/\.mdx?$/, ''))
      );
      const mdFiles = (Array.isArray(itList) ? itList : []).filter(
        (f: any) => f.type === 'file' && /\.mdx?$/.test(f.name)
      );
      const loaded = await Promise.all(
        mdFiles.map(async (f: any) => {
          const r = await ghApi(`/contents/${f.path}?ref=${encodeURIComponent(branch)}`);
          if (!r.ok) return null;
          const json = await r.json();
          const { frontmatter, body } = parseMarkdownFrontmatter(base64ToUtf8(json.content || ''));
          const slug = f.name.replace(/\.mdx?$/, '');
          return {
            slug,
            path: f.path,
            sha: json.sha,
            hasEnglish: enSlugs.has(slug),
            frontmatter: {
              title: String(frontmatter.title || slug),
              description: String(frontmatter.description || ''),
              pubDate: String(frontmatter.pubDate || '').slice(0, 10),
              author: String(frontmatter.author || 'alessandro-capialbi'),
              category: String(frontmatter.category || 'Meccatronica & Hybrid'),
              tags: Array.isArray(frontmatter.tags) ? (frontmatter.tags as string[]) : [],
              level: String(frontmatter.level || 'Intermedio'),
              draft: Boolean(frontmatter.draft),
            },
            body,
          } satisfies ArticleRecord;
        })
      );
      articlesCache = (loaded.filter(Boolean) as ArticleRecord[]).sort((a, b) =>
        b.frontmatter.pubDate.localeCompare(a.frontmatter.pubDate)
      );
    }
    renderArticlesList();
  }

  async function saveArticle() {
    const title = titleInput.value.trim();
    const slug = slugify(slugInput.value || title);
    const description = descInput.value.trim();
    const body = bodyInput.value.trim();
    if (!title || !slug || !body) {
      showBanner('Compila almeno titolo e contenuto dell’articolo.', true);
      return;
    }

    const tags = tagsInput.value
      .split(',')
      .map((t) => t.trim())
      .filter(Boolean);

    const payload = {
      slug,
      title,
      description,
      pubDate: dateInput.value || new Date().toISOString().slice(0, 10),
      author: authorSelect.value,
      category: categorySelect.value,
      tags,
      level: levelSelect.value,
      draft: draftCheckbox.checked,
      body,
      sha: editingSha || undefined,
    };

    publishBtn.disabled = true;
    publishBtn.textContent = 'Salvataggio...';
    hideBanner();

    try {
      if (backendMode === 'cloudflare') {
        const res = await fetch(`${API_BASE}/articles`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Errore salvataggio');
        editingSlug = data.slug;
        editingSha = data.sha;
      } else {
        const path = `src/content/articles/${slug}.md`;
        let sha = editingSha;
        if (!sha) {
          const check = await ghApi(`/contents/${path}?ref=${encodeURIComponent(ghCreds!.branch)}`);
          if (check.ok) sha = (await check.json()).sha;
        }
        const md = serializeMarkdown(payload);
        const res = await ghApi(`/contents/${path}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: sha
              ? `aggiorna articolo: ${slug} (via admin)`
              : `pubblica articolo: ${slug} (via admin)`,
            content: utf8ToBase64(md),
            branch: ghCreds!.branch,
            ...(sha ? { sha } : {}),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Errore commit su GitHub');
        editingSlug = slug;
        editingSha = data?.content?.sha || null;
      }

      slugInput.disabled = true;
      publishBtn.textContent = 'Salva modifiche';
      deleteBtn.hidden = false;
      showBanner(
        payload.draft
          ? 'Bozza salvata su GitHub.'
          : 'Articolo pubblicato su GitHub! La traduzione inglese automatica e il deploy partiranno entro 1-2 minuti.'
      );
      await fetchArticles();
    } catch (err: any) {
      showBanner(err?.message || 'Errore imprevisto durante il salvataggio.', true);
    } finally {
      publishBtn.disabled = false;
      publishBtn.textContent = editingSlug ? 'Salva modifiche' : 'Pubblica articolo';
    }
  }

  async function deleteCurrentArticle() {
    if (!editingSlug) return;
    if (!confirm(`Vuoi davvero eliminare "${titleInput.value || editingSlug}" (e l'eventuale traduzione EN)?`)) {
      return;
    }

    deleteBtn.disabled = true;
    try {
      if (backendMode === 'cloudflare') {
        const res = await fetch(`${API_BASE}/articles`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: editingSlug }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Errore eliminazione');
      } else {
        const itPath = `src/content/articles/${editingSlug}.md`;
        const enPath = `src/content/articles/en/${editingSlug}.md`;
        await ghApi(`/contents/${itPath}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: `elimina articolo: ${editingSlug} (via admin)`,
            sha: editingSha,
            branch: ghCreds!.branch,
          }),
        });
        const enCheck = await ghApi(`/contents/${enPath}?ref=${encodeURIComponent(ghCreds!.branch)}`);
        if (enCheck.ok) {
          const enJson = await enCheck.json();
          await ghApi(`/contents/${enPath}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: `elimina traduzione EN: ${editingSlug} (via admin)`,
              sha: enJson.sha,
              branch: ghCreds!.branch,
            }),
          });
        }
      }
      await fetchArticles();
      resetFormForNew();
      showBanner('Articolo eliminato correttamente.');
    } catch (err: any) {
      showBanner(err?.message || 'Errore durante eliminazione.', true);
    } finally {
      deleteBtn.disabled = false;
    }
  }

  async function uploadImageFile(file: File) {
    const reader = new FileReader();
    reader.onload = async () => {
      const dataUrl = String(reader.result || '');
      const base64 = dataUrl.replace(/^data:[^;]+;base64,/, '');
      const slug = slugify(slugInput.value || titleInput.value || 'articoli') || 'articoli';
      showBanner(`Caricamento immagine "${file.name}" in corso...`);

      try {
        let imageUrl = '';
        if (backendMode === 'cloudflare') {
          const res = await fetch(`${API_BASE}/upload`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, contentBase64: base64, slug }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Errore upload immagine');
          imageUrl = data.url;
        } else {
          const cleanName = file.name.toLowerCase().replace(/[^a-z0-9._-]+/g, '-');
          const stamp = Date.now();
          const repoPath = `public/uploads/${slug}/${stamp}-${cleanName}`;
          const res = await ghApi(`/contents/${repoPath}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: `carica immagine ${cleanName} (via admin)`,
              content: base64,
              branch: ghCreds!.branch,
            }),
          });
          if (!res.ok) throw new Error('Errore upload su GitHub');
          imageUrl = `/uploads/${slug}/${stamp}-${cleanName}`;
        }

        insertAtCursor(`\n![${file.name.replace(/\.[^.]+$/, '')}](${imageUrl})\n`);
        showBanner('Immagine caricata e inserita nell’articolo!');
      } catch (err: any) {
        showBanner(err?.message || 'Errore upload immagine.', true);
      }
    };
    reader.readAsDataURL(file);
  }

  function insertAtCursor(snippet: string, wrapStart?: string, wrapEnd?: string) {
    const start = bodyInput.selectionStart;
    const end = bodyInput.selectionEnd;
    const selected = bodyInput.value.slice(start, end);

    const textToInsert =
      wrapStart && wrapEnd ? `${wrapStart}${selected || snippet}${wrapEnd}` : snippet;

    bodyInput.setRangeText(textToInsert, start, end, 'end');
    bodyInput.focus();
    renderPreview();
  }

