  async function runAiFormat() {
    const body = bodyInput.value.trim();
    if (body.length < 20) {
      showBanner('Scrivi o incolla almeno qualche riga di testo prima di usare l’AI.', true);
      return;
    }

    lastAiSnapshot = {
      title: titleInput.value,
      desc: descInput.value,
      tags: tagsInput.value,
      category: categorySelect.value,
      level: levelSelect.value,
      body: bodyInput.value,
    };

    const origLabel = aiFormatBtn.textContent || '';
    aiFormatBtn.disabled = true;
    aiFormatBtn.textContent = 'Elaborazione AI...';
    hideBanner();

    try {
      const res = await fetch(`${API_BASE}/ai-assist`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mode: 'format',
          title: titleInput.value.trim(),
          body,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore AI');
      const r = data.result || {};

      if (r.body) {
        bodyInput.value = r.body;
        renderPreview();
      }
      if (r.title && !titleInput.value.trim()) {
        titleInput.value = r.title;
        if (!editingSlug && !slugManuallyEdited) slugInput.value = slugify(r.title);
      }
      if (r.description) descInput.value = r.description;
      if (Array.isArray(r.tags) && r.tags.length > 0) tagsInput.value = r.tags.join(', ');
      if (r.category && ['Meccanica', 'AI & Software', 'Meccatronica & Hybrid'].includes(r.category)) {
        categorySelect.value = r.category;
      }
      if (r.level && ['Divulgativo', 'Intermedio', 'Tecnico / Avanzato'].includes(r.level)) {
        levelSelect.value = r.level;
      }

      aiUndoBtn.hidden = false;
      showBanner('Testo impaginato con Markdown e LaTeX. Controlla l’anteprima o clicca "Ripristina" per tornare indietro.');
    } catch (err: any) {
      showBanner(err?.message || 'Errore durante l’elaborazione AI.', true);
    } finally {
      aiFormatBtn.disabled = false;
      aiFormatBtn.textContent = origLabel;
    }
  }

