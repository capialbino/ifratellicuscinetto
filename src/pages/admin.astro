    html.style.setProperty(
      '--font-prose',
      cfg.theme.proseFont === 'serif' ? 'var(--font-serif)' : 'var(--font-sans)'
    );

    document.querySelectorAll('.preset-chip[data-preset-pick]').forEach((el) => {
      el.classList.toggle('active', (el as HTMLElement).dataset.presetPick === cfg.theme.preset);
    });
