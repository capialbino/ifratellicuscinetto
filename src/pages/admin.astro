    html.style.setProperty('--user-accent-dark', cfg.theme.accentDark);
    const radMap: Record<string, [string, string]> = {
      sharp: ['10px', '8px'],
      ive: ['22px', '12px'],
      soft: ['28px', '16px'],
    };
    const [cardR, ctrlR] = radMap[cfg.theme.radius] || radMap.ive;
    html.style.setProperty('--radius-card', cardR);
    html.style.setProperty('--radius-control', ctrlR);
    html.style.setProperty(
      '--font-heading',
      cfg.theme.headingFont === 'serif' ? 'var(--font-serif)' : 'var(--font-display)'
